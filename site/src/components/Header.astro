---
/**
 * Site header: the title band of the desktop. The eye sigil and wordmark on
 * the left, the pages in the display face, the red Download block, and the
 * community links as ruled squares. Below 860px the pages fold into a menu.
 */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pages = [
  { href: '/install', label: 'Install' },
  { href: '/why', label: 'Why' },
  { href: '/theory', label: 'Theory' },
  { href: '/ask-protocol', label: 'Ask Protocol' },
  { href: '/about', label: 'About' },
  { href: '/changelog', label: 'Changelog' },
];
---

<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a href="/" class="logo" aria-label="Abject home">
      <span class="logo-eye" aria-hidden="true"></span>
      <span class="logo-word">Abject</span><span class="logo-tld">.world</span>
    </a>
    <div class="nav-pages">
      {pages.map((p) => (
        <a href={p.href} class:list={['nav-page', { current: path === p.href }]} aria-current={path === p.href ? 'page' : undefined}>{p.label}</a>
      ))}
    </div>
    <div class="nav-actions">
      <a href="/#downloads" class="btn btn-primary nav-dl">Download</a>
      <a href="https://github.com/mempko/abject" class="nav-icon" target="_blank" rel="noopener" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 98 96" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M48.9 0C21.8 0 0 22 0 49.2 0 70.9 14 89.4 33.4 95.9c2.4.5 3.3-1.1 3.3-2.4 0-1.1 0-4.9-.1-8.9-13.6 3-16.4-5.8-16.4-5.8-2.2-5.7-5.4-7.2-5.4-7.2-4.4-3 .3-3 .3-3 4.9.3 7.5 5 7.5 5 4.3 7.5 11.3 5.3 14.1 4.1.4-3.2 1.7-5.3 3.1-6.5-10.8-1.2-22.2-5.4-22.2-24.3 0-5.4 1.9-9.8 5-13.2-.5-1.2-2.2-6.3.5-13 0 0 4.1-1.3 13.4 5a46.4 46.4 0 0 1 24.5 0c9.3-6.3 13.4-5 13.4-5 2.7 6.7 1 11.8.5 13 3.1 3.4 5 7.8 5 13.2 0 18.9-11.5 23.1-22.3 24.3 1.8 1.5 3.3 4.5 3.3 9.1 0 6.5-.1 11.8-.1 13.4 0 1.3.9 2.9 3.4 2.4 19.4-6.5 33.4-25 33.4-46.7C97.8 22 75.9 0 48.9 0z"/>
        </svg>
      </a>
      <a href="https://www.reddit.com/r/AbjectWorld/" class="nav-icon" target="_blank" rel="noopener" aria-label="Reddit">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.358.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
        </svg>
      </a>
      <a href="https://discord.gg/B75AeYUYcF" class="nav-icon" target="_blank" rel="noopener" aria-label="Discord">
        <svg width="20" height="15" viewBox="0 0 71 55" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M60.1 4.9A58.5 58.5 0 0 0 45.4.2a.2.2 0 0 0-.2.1 40.7 40.7 0 0 0-1.8 3.7 54 54 0 0 0-16.2 0A26.4 26.4 0 0 0 25.4.3a.2.2 0 0 0-.2-.1A58.4 58.4 0 0 0 10.5 4.9a.2.2 0 0 0-.1.1C1.5 18.7-.9 32.2.3 45.5v.2a58.9 58.9 0 0 0 17.7 9a.2.2 0 0 0 .3-.1 42.1 42.1 0 0 0 3.6-5.9.2.2 0 0 0-.1-.3 38.8 38.8 0 0 1-5.5-2.6.2.2 0 0 1 0-.4l1.1-.9a.2.2 0 0 1 .2 0 42 42 0 0 0 35.6 0 .2.2 0 0 1 .2 0l1.1.9a.2.2 0 0 1 0 .4 36.4 36.4 0 0 1-5.5 2.6.2.2 0 0 0-.1.3 47.2 47.2 0 0 0 3.6 5.9.2.2 0 0 0 .3.1 58.7 58.7 0 0 0 17.7-9 .2.2 0 0 0 .1-.2c1.4-15-2.3-28.4-9.8-40.1a.2.2 0 0 0-.1-.1ZM23.7 37.3c-3.5 0-6.3-3.2-6.3-7.1 0-3.9 2.8-7.1 6.3-7.1 3.6 0 6.4 3.2 6.3 7.1 0 3.9-2.8 7.1-6.3 7.1Zm23.2 0c-3.5 0-6.3-3.2-6.3-7.1 0-3.9 2.8-7.1 6.3-7.1 3.6 0 6.4 3.2 6.3 7.1 0 3.9-2.7 7.1-6.3 7.1Z"/>
        </svg>
      </a>
      <details class="nav-menu">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <div class="nav-menu-panel">
          {pages.map((p) => (
            <a href={p.href} class:list={{ current: path === p.href }}>{p.label}</a>
          ))}
          <a href="https://github.com/mempko/abject" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.reddit.com/r/AbjectWorld/" target="_blank" rel="noopener">Reddit</a>
          <a href="https://discord.gg/B75AeYUYcF" target="_blank" rel="noopener">Discord</a>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(6, 7, 10, 0.94);
    border-bottom: 1.5px solid var(--rule);
  }

  /* A red hairline on top: the band's edge. */
  .site-header::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: var(--red);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 66px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--bone-heading);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .logo-eye {
    width: 22px;
    height: 22px;
    border: 3px solid var(--red);
    border-radius: 50%;
    position: relative;
  }

  .logo-eye::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 11px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--living);
    box-shadow: 0 0 6px var(--living-glow);
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .logo-tld {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--bone-meta);
    margin-left: -0.35rem;
    align-self: flex-end;
    padding-bottom: 0.25rem;
  }

  .logo:hover .logo-word { color: var(--bone-heading); animation: glitch 3s infinite; }

  .nav-pages {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    margin-left: auto;
  }

  .nav-page {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.86rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bone-3);
    padding: 0.35rem 0;
    white-space: nowrap;
  }

  .nav-page:hover { color: var(--bone-heading); }

  .nav-page.current { color: var(--bone-heading); }

  .nav-page.current::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 3px;
    background: var(--red);
    clip-path: polygon(0 0, 100% 0, calc(100% - 4px) 100%, 0 100%);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-dl {
    padding: 0.5rem 1rem;
    font-size: 0.86rem;
    box-shadow: var(--print-sm);
  }

  .nav-icon {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--bone-3);
    border: 1.5px solid var(--rule-mid);
    background: var(--panel);
  }

  .nav-icon:hover { color: var(--bone-heading); border-color: var(--bone); }

  .nav-icon :global(svg) { width: 17px; height: 17px; }

  /* The folded menu (narrow screens). */
  .nav-menu { display: none; position: relative; }

  .nav-menu summary {
    list-style: none;
    width: 38px;
    height: 34px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 0 8px;
    border: 1.5px solid var(--rule-mid);
    background: var(--panel);
    cursor: pointer;
  }

  .nav-menu summary::-webkit-details-marker { display: none; }

  .nav-menu summary span { display: block; height: 2px; background: var(--bone); }

  .nav-menu[open] summary { border-color: var(--red); }

  .nav-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 220px;
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1.5px solid var(--rule-strong);
    box-shadow: var(--print-red);
  }

  .nav-menu-panel a {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.95rem;
    color: var(--bone-2);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .nav-menu-panel a:last-child { border-bottom: none; }
  .nav-menu-panel a:hover, .nav-menu-panel a.current { color: var(--on-red); background: var(--red); }

  @media (max-width: 1100px) {
    .nav-pages { gap: 1rem; }
    .nav-page { font-size: 0.8rem; letter-spacing: 0.1em; }
  }

  @media (max-width: 960px) {
    .nav-pages { display: none; }
    .nav-actions { margin-left: auto; }
    .nav-menu { display: block; }
  }

  @media (max-width: 520px) {
    .nav-icon { display: none; }
    .logo-tld { display: none; }
  }
</style>
