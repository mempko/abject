---
import SectionHead from './ui/SectionHead.astro';

interface Props {
  num?: string;
}

const { num = '14' } = Astro.props;
---

<section id="summon" class="summon-section">
  <div class="container">
    <SectionHead num={num} kicker="For developers" title="Build It From Source">
      <p>
        This is for developers who want to hack on it. If you just want to <em>use</em> Abject,
        the download is all you need.
      </p>
    </SectionHead>

    <div class="qs-grid">
      <div class="win focus qs-code">
        <div class="win-bar">
          <span class="sigil" aria-hidden="true"></span>
          <span class="title">terminal</span>
          <span class="btns" aria-hidden="true">? &minus; &#9633; &times;</span>
        </div>
        <pre><code><span class="c"># Clone the repository</span>
<span class="cmd">git clone</span> https://github.com/mempko/abject
<span class="cmd">cd</span> abject

<span class="c"># Install dependencies</span>
<span class="cmd">pnpm conjure</span>

<span class="c"># Start the backend server</span>
<span class="cmd">pnpm awaken</span>          <span class="c"># ws://localhost:7719</span>

<span class="c"># Start the browser client (new terminal)</span>
<span class="cmd">pnpm scry</span>            <span class="c"># http://localhost:5174</span>

<span class="c"># Start a local signaling server (optional)</span>
<span class="c"># signal.abject.world is used by default</span>
<span class="cmd">pnpm whisper</span>         <span class="c"># :7720</span>

<span class="c"># Chat from the terminal (optional)</span>
<span class="cmd">pnpm abject</span>          <span class="c"># tabbed TUI on :7723</span></code></pre>
      </div>

      <div class="qs-info">
        <h3>It runs as three processes.</h3>
        <ol class="qs-procs">
          <li>
            <span class="qs-i" aria-hidden="true">01</span>
            <p>
              The <strong>backend</strong> is where all the abjects live: the Registry, Factory,
              LLM, Negotiator, Supervisor and your own abjects. It's a Node.js process with worker
              threads, full of objects passing messages.
            </p>
          </li>
          <li>
            <span class="qs-i" aria-hidden="true">02</span>
            <p>
              The <strong>browser client</strong> draws the desktop. It's a thin canvas renderer
              that sends your input to the backend and shows the frames it gets back over a
              WebSocket.
            </p>
          </li>
          <li>
            <span class="qs-i" aria-hidden="true">03</span>
            <p>
              The <strong>signaling server</strong> introduces peers to each other so they can open
              encrypted WebRTC connections.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .summon-section :global(.lede em) { color: var(--bone-heading); font-style: italic; }

  .qs-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem;
    align-items: start;
  }

  .qs-code pre {
    margin: 0;
    border: none;
    border-left: 4px solid var(--red);
    background: var(--sunken);
    padding: 1.3rem 1.5rem 1.4rem;
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .qs-code code .c { color: var(--bone-meta); }

  .qs-code code .cmd { color: var(--red-hot); font-weight: 700; }

  .qs-info h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .qs-procs {
    list-style: none;
    border-top: var(--rule-w) solid var(--rule-mid);
  }

  .qs-procs li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    padding: 1rem 0;
    border-bottom: var(--rule-w) solid var(--rule);
  }

  .qs-i {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.06em;
    color: var(--red);
    line-height: 1.6;
  }

  .qs-procs p {
    color: var(--bone-2);
    font-size: 0.97rem;
    line-height: 1.65;
  }

  .qs-procs strong { color: var(--bone-heading); }

  @media (max-width: 900px) {
    .qs-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  @media (max-width: 520px) {
    .qs-code pre { padding: 1.1rem 1rem 1.2rem; font-size: 0.8rem; }
  }
</style>
