---
import { latestRelease, platformAssets, fmtSize, fmtDate, LATEST_URL } from '../lib/releases';
import SectionHead from './ui/SectionHead.astro';

interface Props {
  /** Section number in the header. */
  num?: string;
  /** Render this block's own header (a host section may supply its own). */
  head?: boolean;
}
const { num = '05', head = true } = Astro.props;

const rel = await latestRelease();
const pa = platformAssets(rel);
const version = rel.version;
const hasHeadless = !!(pa.headlessLinux || pa.headlessLinuxArm || pa.headlessMacArm || pa.headlessMacX64 || pa.headlessWin);

const size = (a?: { size: number }) => fmtSize(a?.size);
const href = (a?: { url: string }) => a?.url ?? LATEST_URL;
---

<section id="downloads" class="dl-section">
  <div class="container">
    {head && (
      <SectionHead num={num} kicker="Download" title="Get Abject">
        <p class="dl-subtitle">
          It's a desktop app. Download it, open it, pick a model and start talking to it.
        </p>
      </SectionHead>
    )}
    <p class="dl-meta">
      {version && <span class="dl-version">v{version}</span>}
      {rel.date && <span>released {fmtDate(rel.date)}</span>}
      <span class="dl-meta-sep" aria-hidden="true">&#9632;</span>
      <span>GPL-3.0</span>
      <span class="dl-meta-sep" aria-hidden="true">&#9632;</span>
      <a href="/install">install guide</a>
    </p>

    <div class="dl-grid">

      <!-- Linux -->
      <article class="dl-card" data-os="linux" aria-label="Linux downloads">
        <span class="dl-yours" hidden>your system</span>
        <h3 class="dl-platform">Linux</h3>
        <div class="dl-card-body">
          <span class="dl-arch">x64</span>
          <div class="dl-buttons">
            <a href={href(pa.linuxAppImage)} class="dl-btn" rel="noopener">
              AppImage {size(pa.linuxAppImage) && <span class="dl-size">{size(pa.linuxAppImage)}</span>}
            </a>
            <a href={href(pa.linuxDeb)} class="dl-alt" rel="noopener">
              .deb {size(pa.linuxDeb) && <span class="dl-size">{size(pa.linuxDeb)}</span>}
            </a>
          </div>
        </div>
      </article>

      <!-- Windows -->
      <article class="dl-card" data-os="win" aria-label="Windows downloads">
        <span class="dl-yours" hidden>your system</span>
        <h3 class="dl-platform">Windows</h3>
        <div class="dl-card-body">
          <span class="dl-arch">10 or later, x64</span>
          <div class="dl-buttons">
            <a href={href(pa.winExe)} class="dl-btn" rel="noopener">
              Installer (.exe) {size(pa.winExe) && <span class="dl-size">{size(pa.winExe)}</span>}
            </a>
          </div>
        </div>
      </article>

      <!-- macOS -->
      <article class="dl-card" data-os="mac" aria-label="macOS downloads">
        <span class="dl-yours" hidden>your system</span>
        <h3 class="dl-platform">macOS</h3>
        <div class="dl-card-body">
          <span class="dl-arch">{pa.macX64Dmg ? 'Apple Silicon and Intel' : 'Apple Silicon'}</span>
          <div class="dl-buttons">
            <a href={href(pa.macArmDmg)} class="dl-btn" rel="noopener">
              {pa.macX64Dmg ? 'Apple Silicon .dmg' : '.dmg'} {size(pa.macArmDmg) && <span class="dl-size">{size(pa.macArmDmg)}</span>}
            </a>
            {pa.macX64Dmg && (
              <a href={pa.macX64Dmg.url} class="dl-btn dl-btn-second" rel="noopener">
                Intel .dmg <span class="dl-size">{size(pa.macX64Dmg)}</span>
              </a>
            )}
            <a href={href(pa.macArmZip)} class="dl-alt" rel="noopener">
              .zip {size(pa.macArmZip) && <span class="dl-size">{size(pa.macArmZip)}</span>}
            </a>
          </div>
        </div>
      </article>

    </div>

    <p class="dl-unsigned">
      <span class="dl-unsigned-mark" aria-hidden="true">!</span>
      <span>
        The builds aren't code-signed yet, so your OS will warn you once before the first launch.
        <a href="/install#first-launch">Here's what to click</a> on each platform. It takes ten seconds.
      </span>
    </p>

    <div class:list={['dl-companions', { split: hasHeadless }]}>
      {hasHeadless && (
        <div class="dl-companion" data-companion="abject">
          <p class="side-label dl-companion-head">
            <span class="dl-companion-title">abject, the command line</span>
            <span class="tag brass dl-companion-tag">no screen needed</span>
          </p>
          <p class="dl-companion-desc">
            The same agents in a terminal: on a server, over SSH, or on a machine with no
            screen. It starts its own backend in the background, and the backend keeps
            working after you quit. When the desktop app is open, it talks to that instead.<sup>†</sup>
          </p>
          <pre class="dl-install"><code>curl -fsSL https://abject.world/install.sh | sh</code></pre>
          <pre class="dl-install"><code>irm https://abject.world/install.ps1 | iex</code><span class="dl-install-os">Windows</span></pre>
          <div class="dl-companion-links">
            {pa.headlessLinux && <a href={pa.headlessLinux.url} rel="noopener">Linux (x64)</a>}
            {pa.headlessLinuxArm && <a href={pa.headlessLinuxArm.url} rel="noopener">Linux (ARM64)</a>}
            {pa.headlessMacArm && <a href={pa.headlessMacArm.url} rel="noopener">macOS (Apple&nbsp;Silicon)</a>}
            {pa.headlessMacX64 && <a href={pa.headlessMacX64.url} rel="noopener">macOS (Intel)</a>}
            {pa.headlessWin && <a href={pa.headlessWin.url} rel="noopener">Windows (x64)</a>}
          </div>
          <p class="dl-companion-foot">
            † The desktop app comes with the command too, so one command works with either.
          </p>
        </div>
      )}

      {hasHeadless && <div class="rule" aria-hidden="true"></div>}

      <div class="dl-companion" data-companion="phone">
        <p class="side-label dl-companion-head">
          <span class="dl-companion-title">your phone</span>
          <span class="tag dl-companion-tag">nothing to install</span>
        </p>
        <p class="dl-companion-desc">
          Open Network in the app, make a pairing QR code and scan it with your phone. Your
          desktop opens in the phone's browser over an encrypted WebRTC connection, straight to
          your machine. It works from the couch and from a cell network across town.
        </p>
        <div class="dl-companion-links">
          <a href="/install#phone">How pairing works</a>
        </div>
      </div>
    </div>

    <p class="dl-invite band">
      Try it, break it, build something horrible with it.
    </p>
    <p class="dl-note">
      All downloads come from the
      <a href={rel.pageUrl} target="_blank" rel="noopener">{version ? `v${version} release` : 'latest release'}</a>
      on GitHub. There's no auto-updater yet. A new version installs over the old one and keeps your data.
    </p>
  </div>
</section>

<script>
  // The visitor's own platform wears the red: its window takes focus and
  // its download becomes the red block. Phones get the phone card instead.
  const ua = navigator.userAgent;
  const plat = navigator.platform || '';
  const mobile = /Android|iPhone|iPad|iPod/i.test(ua) || (plat === 'MacIntel' && navigator.maxTouchPoints > 1);
  let key: 'linux' | 'win' | 'mac' | 'phone' | null = null;
  if (mobile) key = 'phone';
  else if (/Win/.test(plat)) key = 'win';
  else if (/Mac/.test(plat)) key = 'mac';
  else if (/Linux|X11/.test(plat)) key = 'linux';
  const card = key === 'phone'
    ? document.querySelector('#downloads [data-companion="phone"]')
    : key ? document.querySelector(`#downloads [data-os="${key}"]`) : null;
  if (card) {
    card.classList.add('focus');
    const yours = card.querySelector('.dl-yours') as HTMLElement | null;
    if (yours) yours.hidden = false;
  }
</script>

<style>
  .dl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--bone-meta);
    margin: -1.5rem 0 2.5rem;
  }

  .dl-version {
    color: var(--bone-heading);
    font-weight: 700;
    background: var(--band);
    border: 1px solid var(--rule-mid);
    padding: 0.05rem 0.45rem;
  }

  .dl-meta-sep { color: var(--red); font-size: 0.55rem; }

  .dl-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  /* Platform blocks: outlined slabs; the visitor's own turns solid red. */
  .dl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.6rem 1.5rem 1.7rem;
    border: 2px solid var(--rule-strong);
    transition: transform 0.15s, box-shadow 0.15s, background-color 0.15s;
  }

  .dl-card:hover { transform: translate(-2px, -2px); box-shadow: var(--print); }

  .dl-platform {
    font-size: clamp(2.2rem, 3.6vw, 3.2rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: var(--bone-heading);
  }

  .dl-card-body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .dl-arch {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--bone-meta);
    letter-spacing: 0.02em;
  }

  .dl-yours {
    align-self: flex-start;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-red);
    border: 1px solid rgba(246, 239, 219, 0.75);
    padding: 0.05rem 0.45rem;
  }

  .dl-card.focus {
    background: var(--red);
    border-color: var(--red);
    box-shadow: var(--print);
  }

  .dl-card.focus:hover { box-shadow: 8px 8px 0 var(--shadow-ink); }
  .dl-card.focus .dl-platform { color: var(--on-red); font-size: clamp(2.6rem, 4.4vw, 4rem); }
  .dl-card.focus .dl-arch { color: rgba(246, 239, 219, 0.85); }

  .dl-buttons {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.7rem;
  }

  .dl-btn {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone-heading);
    background: transparent;
    border: var(--rule-w) solid var(--rule-strong);
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.15s, border-color 0.15s, color 0.15s;
  }

  .dl-btn:hover {
    color: var(--bone-heading);
    border-color: var(--bone);
    background: var(--panel);
    transform: translate(-1px, -1px);
    box-shadow: var(--print-sm);
  }

  .dl-btn:active { transform: translate(2px, 2px); box-shadow: none; }

  /* On the red block the download is an ink slab that presses in. */
  .dl-card.focus .dl-btn:not(.dl-btn-second) {
    background: var(--void);
    border-color: var(--void);
    color: var(--on-red);
    box-shadow: 5px 5px 0 var(--red-deep);
  }

  .dl-card.focus .dl-btn:not(.dl-btn-second):hover { background: #16130f; }

  .dl-card.focus .dl-btn-second { border-color: rgba(246, 239, 219, 0.7); color: var(--on-red); }
  .dl-card.focus .dl-btn-second:hover { background: var(--red-hot); }

  .dl-size {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-transform: none;
    opacity: 0.8;
  }

  .dl-alt {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(91, 229, 160, 0.45);
  }

  .dl-alt:hover { text-decoration-color: var(--red); }

  .dl-card.focus .dl-alt { color: var(--on-red); text-decoration-color: rgba(246, 239, 219, 0.6); }

  .dl-unsigned {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    max-width: 760px;
    margin: 2.25rem 0 0;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 4px solid var(--brass);
    font-size: 0.92rem;
    color: var(--bone-2);
    line-height: 1.6;
  }

  .dl-unsigned-mark {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 0.1rem;
    border: 1.5px solid var(--brass);
    color: var(--brass);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
  }

  /* Companions: a split, content straight on the void. */
  .dl-companions { margin-top: 4rem; }

  .dl-companion-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .dl-companion-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    color: var(--bone-heading);
  }

  .dl-companion-tag { font-size: 0.64rem; letter-spacing: 0.1em; }

  .dl-companion.focus .dl-companion-title { color: var(--red); }
  .dl-companion.focus .dl-companion-tag { background: var(--red); border-color: var(--red); color: var(--on-red); }

  .dl-companion-desc {
    font-size: 1rem;
    color: var(--bone-2);
    line-height: 1.65;
    margin-bottom: 0.9rem;
    max-width: 52ch;
  }

  .dl-companion-desc sup { color: var(--brass); }

  .dl-companion-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .dl-companion-links a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(91, 229, 160, 0.45);
  }

  .dl-companion-links a:hover { text-decoration-color: var(--red); }

  .dl-install {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.6rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--rule);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--bone-heading);
  }

  .dl-install:last-of-type { margin-bottom: 0.9rem; }

  .dl-install-os {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-meta);
  }

  .dl-companion-foot {
    margin-top: 1rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--bone-meta);
  }

  .dl-invite {
    margin-top: 4.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.6vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--bone-heading);
    max-width: 24ch;
  }

  .dl-note {
    margin-top: 1.25rem;
    max-width: 620px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--bone-meta);
    line-height: 1.65;
  }

  .dl-note a { font-family: var(--font-mono); }

  @media (max-width: 900px) {
    .dl-grid { grid-template-columns: 1fr; max-width: 520px; }
  }
</style>
