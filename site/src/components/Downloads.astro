---
import { latestRelease, platformAssets, fmtSize, fmtDate, LATEST_URL } from '../lib/releases';

const rel = await latestRelease();
const pa = platformAssets(rel);
const version = rel.version;
const hasCommune = !!(pa.communeLinux || pa.communeWin || pa.communeMac);

const size = (a?: { size: number }) => fmtSize(a?.size);
const href = (a?: { url: string }) => a?.url ?? LATEST_URL;
---

<section id="downloads">
  <div class="container">
    <h2 class="section-title">Get Abject</h2>
    <p class="dl-subtitle">
      A standalone desktop app. Download, open, pick a mind, start talking.
    </p>
    <p class="dl-meta">
      {version && <span class="dl-version">v{version}</span>}
      {rel.date && <span>released {fmtDate(rel.date)}</span>}
      <span class="dl-meta-sep">&middot;</span>
      <span>GPL-3.0</span>
      <span class="dl-meta-sep">&middot;</span>
      <a href="/install">install guide</a>
    </p>
    <div class="dl-grid">

      <!-- Linux -->
      <div class="dl-card">
        <svg class="dl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
          <path d="M12 8v4l2.5 2.5"/>
          <path d="M8 3.5C5.5 5 3.5 8 3.5 12c0 4.5 3.5 8.5 8.5 8.5s8.5-4 8.5-8.5c0-4-2-7-4.5-8.5"/>
          <circle cx="12" cy="12" r="2"/>
        </svg>
        <span class="dl-platform">Linux</span>
        <span class="dl-arch">x64</span>
        <div class="dl-buttons">
          <a href={href(pa.linuxAppImage)} class="dl-btn" rel="noopener">
            AppImage {size(pa.linuxAppImage) && <span class="dl-size">{size(pa.linuxAppImage)}</span>}
          </a>
          <a href={href(pa.linuxDeb)} class="dl-alt" rel="noopener">
            .deb {size(pa.linuxDeb) && <span class="dl-size">{size(pa.linuxDeb)}</span>}
          </a>
        </div>
      </div>

      <!-- Windows -->
      <div class="dl-card">
        <svg class="dl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <path d="M3 9h18"/>
          <path d="M9 3v6"/>
          <path d="M3 9l4 4-4 4"/>
          <path d="M21 9l-4 4 4 4"/>
        </svg>
        <span class="dl-platform">Windows</span>
        <span class="dl-arch">10 or later, x64</span>
        <div class="dl-buttons">
          <a href={href(pa.winExe)} class="dl-btn" rel="noopener">
            Installer (.exe) {size(pa.winExe) && <span class="dl-size">{size(pa.winExe)}</span>}
          </a>
        </div>
      </div>

      <!-- macOS -->
      <div class="dl-card">
        <svg class="dl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/>
          <path d="M12 2c3 3 4.5 7 4.5 10S15 19 12 22"/>
          <path d="M12 2c-3 3-4.5 7-4.5 10S9 19 12 22"/>
          <path d="M2 12h20"/>
        </svg>
        <span class="dl-platform">macOS</span>
        <span class="dl-arch">{pa.macX64Dmg ? 'Apple Silicon and Intel' : 'Apple Silicon'}</span>
        <div class="dl-buttons">
          <a href={href(pa.macArmDmg)} class="dl-btn" rel="noopener">
            {pa.macX64Dmg ? 'Apple Silicon .dmg' : '.dmg'} {size(pa.macArmDmg) && <span class="dl-size">{size(pa.macArmDmg)}</span>}
          </a>
          {pa.macX64Dmg && (
            <a href={pa.macX64Dmg.url} class="dl-btn dl-btn-second" rel="noopener">
              Intel .dmg <span class="dl-size">{size(pa.macX64Dmg)}</span>
            </a>
          )}
          <a href={href(pa.macArmZip)} class="dl-alt" rel="noopener">
            .zip {size(pa.macArmZip) && <span class="dl-size">{size(pa.macArmZip)}</span>}
          </a>
        </div>
      </div>

    </div>

    <p class="dl-unsigned">
      The builds are not code-signed yet, so your OS will pause once before the first launch.
      <a href="/install#first-launch">What to click</a>, per platform, takes ten seconds.
    </p>

    <div class="dl-companions">
      {hasCommune && (
        <div class="dl-companion">
          <div class="dl-companion-head">
            <span class="dl-companion-title">commune, the terminal client</span>
            <span class="dl-companion-tag">companion</span>
          </div>
          <p class="dl-companion-desc">
            Your chats, goals, and permission prompts in a tabbed TUI. A single
            executable, no install. It talks to the desktop app above, which
            must be running.<sup>†</sup>
          </p>
          <div class="dl-companion-links">
            {pa.communeLinux && <a href={pa.communeLinux.url} rel="noopener">Linux (x64)</a>}
            {pa.communeWin && <a href={pa.communeWin.url} rel="noopener">Windows (x64)</a>}
            {pa.communeMac && <a href={pa.communeMac.url} rel="noopener">macOS (Apple&nbsp;Silicon)</a>}
          </div>
          <p class="dl-companion-foot">
            † The terminal is a view, not a second brain. All the abjects live in the app.
          </p>
        </div>
      )}

      <div class="dl-companion">
        <div class="dl-companion-head">
          <span class="dl-companion-title">your phone</span>
          <span class="dl-companion-tag">nothing to install</span>
        </div>
        <p class="dl-companion-desc">
          Open Network, generate a pairing QR, scan it. Your desktop opens in the phone's
          browser over an encrypted WebRTC channel, straight to your machine. Works from
          the couch and from a cell network across town.
        </p>
        <div class="dl-companion-links">
          <a href="/install#phone">How pairing works</a>
        </div>
      </div>
    </div>

    <p class="dl-invite">
      Try it. Break it. Build something slightly cursed.
    </p>
    <p class="dl-note">
      All downloads from the
      <a href={rel.pageUrl} target="_blank" rel="noopener">{version ? `v${version} release` : 'latest release'}</a>
      on GitHub. No auto-updater yet: new versions install over the old one and keep your data.
    </p>
  </div>
</section>

<style>
  #downloads {
    padding: var(--section-gap) 0;
  }

  .dl-subtitle {
    text-align: center;
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .dl-meta {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.5rem;
  }

  .dl-meta a {
    color: var(--eldritch-dim);
  }

  .dl-meta a:hover {
    color: var(--eldritch);
    text-decoration: underline;
  }

  .dl-version {
    color: var(--eldritch-dim);
    font-weight: 600;
  }

  .dl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 760px;
    margin: 0 auto;
  }

  .dl-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .dl-card:hover {
    border-color: var(--border-accent);
    box-shadow: 0 0 24px var(--eldritch-glow);
    transform: translateY(-2px);
  }

  .dl-icon {
    width: 36px;
    height: 36px;
    color: var(--eldritch);
  }

  .dl-platform {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .dl-arch {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    margin-top: -0.35rem;
  }

  .dl-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.4rem;
  }

  .dl-btn {
    display: inline-block;
    width: 100%;
    text-align: center;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--bg-primary);
    background: var(--eldritch);
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .dl-btn:hover {
    background: #fff;
    box-shadow: 0 0 16px var(--eldritch-glow);
  }

  .dl-btn-second {
    background: transparent;
    color: var(--eldritch);
    border: 1px solid var(--eldritch);
  }

  .dl-btn-second:hover {
    background: var(--eldritch-glow);
    color: var(--eldritch);
  }

  .dl-size {
    font-weight: 400;
    opacity: 0.7;
    margin-left: 0.35rem;
    font-size: 0.78em;
  }

  .dl-alt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.2s;
  }

  .dl-alt:hover {
    color: var(--eldritch);
    text-decoration: underline;
  }

  .dl-unsigned {
    max-width: 640px;
    margin: 1.5rem auto 0;
    text-align: center;
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .dl-companions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
    max-width: 860px;
    margin: 2rem auto 0;
  }

  .dl-companion {
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .dl-companion-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .dl-companion-title {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .dl-companion-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--eldritch-dim);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }

  .dl-companion-desc {
    margin: 0.5rem 0 0.75rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .dl-companion-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .dl-companion-links a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--eldritch);
    text-decoration: none;
  }

  .dl-companion-links a:hover {
    text-decoration: underline;
  }

  .dl-companion-foot {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: var(--text-dim);
    font-style: italic;
  }

  .dl-invite {
    text-align: center;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .dl-note {
    text-align: center;
    max-width: 560px;
    margin: 1.5rem auto 0;
    font-size: 0.85rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .dl-note a {
    color: var(--eldritch-dim);
    text-decoration: none;
  }

  .dl-note a:hover {
    color: var(--eldritch);
    text-decoration: underline;
  }

  @media (max-width: 680px) {
    .dl-grid {
      grid-template-columns: 1fr;
      max-width: 320px;
    }
  }
</style>
