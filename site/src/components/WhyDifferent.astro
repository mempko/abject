---
/**
 * 05 Why different, on the red poster ground: three statements set as
 * poster columns (a struck-through "not a ...", the claim in big type, the
 * reasoning beneath), divided by bone rules. The middle one (not an agent
 * framework) is the heart of the argument, so it is set in ink.
 */
import SectionHead from './ui/SectionHead.astro';

interface Props {
  num?: string;
  kicker?: string;
  title?: string;
  /** Where "The full comparison" points (on /why itself, a section below). */
  fullHref?: string;
}

const {
  num = '05',
  kicker = 'Why different',
  title = 'How is Abject different?',
  fullHref = '/why',
} = Astro.props;

const points = [
  {
    glyph: '{≠}',
    label: 'Not a chatbot',
    title: 'It keeps running.',
    body: 'A chat answer scrolls away. An abject is a running object with a window, a mailbox and its own source code. Close the chat and it keeps working. It keeps refreshing the tide chart, feeding the fish and watching the inbox.',
  },
  {
    glyph: '{∅}',
    label: 'Not an agent framework',
    title: 'No hierarchy.',
    key: true,
    body: 'Agent frameworks are hierarchical. A planner sits on top and the tools sit underneath. Here every piece, the tools included, is an object you can ask what it does, and it can ask you back. An AI agent is just another abject. The LLM is a service an object calls when it needs to think.',
  },
  {
    glyph: '{⋈}',
    label: 'Not a cloud',
    title: 'No accounts.',
    body: 'Your machine generates its own cryptographic key, and that key is its address. Peers find each other over encrypted WebRTC. A goal you start here keeps going on every peer that joined it. Nobody rents you your own software.',
  },
];
---

<section id="why" class="why-section field-red cut-top">
  <div class="container">
    <SectionHead num={num} kicker={kicker} title={title}>
      The whole system is built as a bunch of objects communicating with each other, Smalltalk
      or Erlang style, where each object has this <em class="ask-word">ask</em> handler. Ask any
      object what it does and it tells you, in plain English.
    </SectionHead>

    <div class="why-cols">
      {points.map((p, i) => (
        <article class:list={['why-col', { key: p.key }]}>
          <div class="why-top">
            <span class="why-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="why-glyph" aria-hidden="true">{p.glyph}</span>
          </div>
          <p class="why-label"><span class="why-not">Not</span> {p.label.replace(/^Not /, '')}</p>
          <h3 class="why-title">{p.title}</h3>
          <p class="why-body">{p.body}</p>
        </article>
      ))}
    </div>

    <p class="why-cta">
      <a href={fullHref} class="btn why-btn">The full comparison &rarr;</a>
      <a href="/ask-protocol" class="btn why-btn">The Ask Protocol &rarr;</a>
      <a href="/theory" class="btn why-btn">The theory &rarr;</a>
    </p>
  </div>
</section>

<style>
  .why-section :global(.lede) { color: var(--field-ink-2); }

  .ask-word {
    font-family: var(--font-mono);
    font-style: normal;
    color: var(--on-red);
    background: var(--field-accent);
    padding: 0 0.35rem;
  }

  /* Poster columns: three statements under a heavy ink rule, divided by
     bone hairlines. */
  .why-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 4px solid var(--field-accent);
  }

  .why-col {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.8rem 0.6rem;
    border-left: 1.5px solid var(--field-rule);
  }

  .why-col:first-child { border-left: none; padding-left: 0; }
  .why-col:last-child { padding-right: 0; }

  .why-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.4rem;
  }

  .why-n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.4rem, 6vw, 5.4rem);
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 2px var(--on-red);
  }

  .why-col.key .why-n { color: var(--field-accent); -webkit-text-stroke: 0; }

  .why-glyph {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    color: var(--on-red);
  }

  .why-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-red);
    margin-bottom: 0.8rem;
  }

  .why-not {
    background: var(--field-accent);
    color: var(--on-red);
    padding: 0.05rem 0.4rem;
    margin-right: 0.2rem;
  }

  .why-title {
    font-size: clamp(1.9rem, 3.2vw, 2.8rem);
    font-weight: 700;
    line-height: 0.98;
    margin-bottom: 1.1rem;
  }

  .why-col.key .why-title {
    align-self: flex-start;
    background: var(--field-accent);
    color: var(--on-red);
    padding: 0.2rem 0.5rem 0.3rem;
    margin-left: -0.5rem;
  }

  .why-body {
    font-size: 1rem;
    line-height: 1.65;
  }

  .why-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  /* Ink buttons on the red ground, pressing into a darker shadow. */
  .why-btn {
    background: var(--field-accent);
    color: var(--on-red);
    border-color: var(--field-accent);
    box-shadow: 5px 5px 0 var(--red-deep);
    text-decoration: none;
  }

  .why-cta .why-btn:hover {
    color: var(--on-red);
    background: #000;
    transform: translate(-1px, -1px);
    box-shadow: 6px 6px 0 var(--red-deep);
  }

  .why-btn:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--red-deep); }
  .why-btn:focus-visible { outline-color: var(--field-accent); }

  @media (max-width: 900px) {
    .why-cols { grid-template-columns: 1fr; }
    .why-col, .why-col:first-child, .why-col:last-child {
      padding: 1.6rem 0 1.4rem;
      border-left: none;
    }
    .why-col + .why-col { border-top: 1.5px solid var(--field-rule); }
    .why-body { max-width: 640px; }
  }

  @media (max-width: 640px) {
    .why-cta { flex-direction: column; align-items: stretch; }
    .why-cta .why-btn { white-space: normal; }
  }
</style>
