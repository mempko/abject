---
import changelog from '../data/changelog.json';
import { fmtDate } from '../lib/releases';

interface Entry {
  version: string;
  date: string;
  title: string;
  summary: string;
  highlights: string[];
  fixes: string[];
}

const entries = changelog as Entry[];
const latest = entries[0];
const top = latest?.highlights.slice(0, 3) ?? [];
---

{latest && (
  <section id="whats-new" class="new-section">
    <div class="container">
      <p class="kicker"><span class="num">08</span><span>New</span></p>
      <h2 class="poster-quote new-title">{latest.title}</h2>

      <div class="new-grid">
        <div class="stat new-stat">
          <span class="big">v{latest.version}</span>
          <span class="cap">Latest release &middot; <time datetime={latest.date}>{fmtDate(latest.date)}</time></span>
        </div>

        <div class="new-body">
          <p class="new-summary">{latest.summary}</p>
          <ol class="new-list">
            {top.map((h) => <li>{h}</li>)}
          </ol>
        </div>

        <ul class="new-links">
          <li><a href={`/changelog#v${latest.version}`}>Full notes for this release</a></li>
          <li><a href="/changelog">All releases</a></li>
          <li><a href="https://github.com/mempko/abject/releases" target="_blank" rel="noopener">GitHub Releases</a></li>
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  .new-section {
    padding: calc(var(--section-gap) * 0.8) 0;
  }

  .new-title {
    margin: 0.4rem 0 3rem;
    max-width: 22ch;
  }

  .new-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 2.5rem;
    align-items: start;
    padding-top: 2rem;
    border-top: var(--rule-w) solid var(--rule-strong);
  }

  .new-stat .big { font-size: clamp(3.4rem, 7vw, 6rem); }

  .new-stat .cap { margin-top: 0.6rem; }

  .new-summary {
    color: var(--bone);
    font-size: 1.08rem;
    line-height: 1.65;
    margin-bottom: 1.2rem;
  }

  .new-list {
    list-style: none;
    counter-reset: hl;
    border-top: 1px solid var(--rule-mid);
  }

  .new-list li {
    counter-increment: hl;
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--bone-2);
    font-size: 0.97rem;
    line-height: 1.65;
  }

  .new-list li::before {
    content: counter(hl, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--red);
    line-height: 2.1;
  }

  .new-links {
    list-style: none;
    border-top: 1px solid var(--rule-mid);
  }

  .new-links li { border-bottom: 1px solid var(--rule); }

  .new-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    text-decoration: none;
  }

  .new-links a::after {
    content: '\25B6';
    font-size: 0.6rem;
    color: var(--red);
    transition: transform 0.15s;
  }

  .new-links a:hover::after { transform: translateX(3px); }

  @media (max-width: 1000px) {
    .new-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .new-body { grid-column: 1 / -1; grid-row: 2; }
  }

  @media (max-width: 640px) {
    .new-grid { grid-template-columns: 1fr; gap: 2rem; }
    .new-body { grid-row: auto; }
    .new-title { margin-bottom: 2rem; }
  }
</style>
