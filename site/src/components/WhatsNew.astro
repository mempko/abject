---
import changelog from '../data/changelog.json';
import { fmtDate } from '../lib/releases';

interface Entry {
  version: string;
  date: string;
  title: string;
  summary: string;
  highlights: string[];
  fixes: string[];
}

const entries = changelog as Entry[];
const latest = entries[0];
const top = latest?.highlights.slice(0, 3) ?? [];
---

{latest && (
  <section id="whats-new" class="new-section">
    <div class="container">
      <div class="new-box">
        <div class="new-head">
          <span class="new-eyebrow">// LATEST RELEASE</span>
          <span class="new-version">v{latest.version}</span>
          <time class="new-date" datetime={latest.date}>{fmtDate(latest.date)}</time>
        </div>
        <h2 class="new-title">{latest.title}</h2>
        <p class="new-summary">{latest.summary}</p>
        <ul class="new-list">
          {top.map((h) => <li>{h}</li>)}
        </ul>
        <p class="new-links">
          <a href={`/changelog#v${latest.version}`}>Full notes for this release</a>
          <span class="sep">|</span>
          <a href="/changelog">Every release</a>
          <span class="sep">|</span>
          <a href="https://github.com/mempko/abject/releases" target="_blank" rel="noopener">GitHub Releases</a>
        </p>
      </div>
    </div>
  </section>
)}

<style>
  .new-section {
    padding: calc(var(--section-gap) * 0.6) 0;
  }

  .new-box {
    max-width: 860px;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-accent);
    border-radius: 12px;
    box-shadow: 0 0 24px var(--eldritch-glow);
  }

  .new-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
  }

  .new-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--text-dim);
  }

  .new-version {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--eldritch);
  }

  .new-date {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .new-title {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .new-summary {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.7;
    margin-bottom: 0.9rem;
  }

  .new-list {
    padding-left: 1.25rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .new-list li {
    margin-bottom: 0.35rem;
  }

  .new-list li::marker {
    color: var(--eldritch);
  }

  .new-links {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .new-links .sep {
    margin: 0 0.5rem;
    opacity: 0.5;
  }
</style>
