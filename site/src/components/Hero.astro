---
import { latestRelease, platformAssets, fmtSize } from '../lib/releases';

const rel = await latestRelease();
const pa = platformAssets(rel);

// Per-platform direct links for the OS-aware button. Everything renders
// without JavaScript; the script only upgrades the primary button.
const direct = {
  linux: pa.linuxAppImage,
  linuxAlt: pa.linuxDeb,
  win: pa.winExe,
  mac: pa.macArmDmg,
  macAlt: pa.macX64Dmg,
};
---

<section class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-content">
    <h1>
      An <span class="accent">Abject-Oriented</span> OS
    </h1>
    <p class="hero-hook">
      Describe what you want. An <em>abject</em> appears, window and all,
      and it keeps working after you stop talking to it.
    </p>
    <p class="hero-sub">
      For anyone, not just developers. Free, open source, and local-first:
      your machine, your data, no cloud, no code required.
    </p>
    <div class="hero-actions">
      <a
        href="#downloads"
        class="btn btn-primary hero-dl"
        id="hero-dl"
        data-linux-url={direct.linux?.url}
        data-linux-size={fmtSize(direct.linux?.size)}
        data-linux-alt-url={direct.linuxAlt?.url}
        data-win-url={direct.win?.url}
        data-win-size={fmtSize(direct.win?.size)}
        data-mac-url={direct.mac?.url}
        data-mac-size={fmtSize(direct.mac?.size)}
        data-mac-alt-url={direct.macAlt?.url}
      >Download</a>
      <a href="#summon" class="btn btn-outline">Build from Source</a>
    </div>
    <p class="hero-meta">
      {rel.version && <span class="hero-version">v{rel.version}</span>}
      <span>Linux &middot; Windows &middot; macOS</span>
      <span class="hero-meta-sep">&middot;</span>
      <span>free and open source, GPL-3.0</span>
      <span class="hero-meta-sep">&middot;</span>
      <a href="/install">install guide</a>
      <span id="hero-dl-alt" class="hero-dl-alt"></span>
    </p>
    <p class="hero-needs">
      Needs a mind to borrow: an API key, a free local model through Ollama,
      or the coding CLI you already log into. You pick on first launch.
    </p>

    <figure class="hero-shot">
      <button class="sighting-frame hero-shot-frame" type="button" data-full="/gallery/desktop.webp" aria-label="Enlarge screenshot">
        <img
          src="/gallery/desktop.webp"
          alt="A full Abject desktop: a chat window creating a weather abject, a Seattle tide schedule widget, and a large colorful graph of wiki notes, with a sidebar of running abjects"
          width="1600"
          height="1000"
          decoding="async"
          fetchpriority="high"
        />
      </button>
      <figcaption class="hero-shot-caption">
        A real desktop, mid-sentence: a weather abject being spoken into existence while
        the tide schedule and a map of 427 wiki notes keep running. Nothing staged.
      </figcaption>
    </figure>

    <div class="hero-glyphs">
      <div class="hero-glyph">
        <span class="glyph-icon">{'{'}?{'}'}</span>
        <span class="glyph-text">Objects that explain themselves</span>
      </div>
      <div class="hero-glyph">
        <span class="glyph-icon">{'{'}!{'}'}</span>
        <span class="glyph-text">Objects that repair their own plumbing</span>
      </div>
      <div class="hero-glyph">
        <span class="glyph-icon">{'{'}*{'}'}</span>
        <span class="glyph-text">Software that grows by adoption</span>
      </div>
    </div>

    <h2 class="section-title hero-desc-heading">What are Abjects?</h2>
    <div class="ask-demo">
      <p class="ask-call">
        <span class="ask-you">you</span><span class="ask-op">&gt;</span><code class="ask-code">{'ask({ question: "what are you?" })'}</code><span class="ask-cursor" aria-hidden="true"></span>
      </p>
      <div class="ask-reply">
        <div class="ask-reply-bar">
          <span class="ask-reply-title"><span class="ask-reply-icon">💬</span> reply from: abject</span>
          <span class="ask-reply-controls" aria-hidden="true">?&ensp;&minus;&ensp;&times;</span>
        </div>
        <div class="ask-reply-body">
          <p>
            Not an app. A small living object: a window, an agent, a tool, a peer.
            I carry my own description, talk to my neighbors through messages, and
            answer for myself in plain English. Which is what I am doing right now.
            Politely.
          </p>
          <p>
            Engineers will recognize my species: an actor, but one you can interview.
            <a href="/ask-protocol" class="thesis-link">Read the Ask Protocol &rarr;</a>
          </p>
        </div>
      </div>
    </div>
    <p class="hero-tagline">
      abject <span class="dim">(n.)</span> 1. an AI object. 2. &lsquo;utterly hopeless&rsquo;.
      Anyone who has maintained object-oriented code knows the two meanings are compatible.
    </p>
  </div>
</section>

<script>
  // OS-aware primary button. Phones and unknown platforms keep the anchor
  // to the download section, which lists everything.
  const btn = document.getElementById('hero-dl') as HTMLAnchorElement | null;
  const alt = document.getElementById('hero-dl-alt');
  if (btn) {
    const ua = navigator.userAgent;
    const plat = navigator.platform || '';
    const mobile = /Android|iPhone|iPad|iPod/i.test(ua) || (plat === 'MacIntel' && navigator.maxTouchPoints > 1);
    let key: 'linux' | 'win' | 'mac' | null = null;
    if (!mobile) {
      if (/Win/.test(plat)) key = 'win';
      else if (/Mac/.test(plat)) key = 'mac';
      else if (/Linux|X11/.test(plat)) key = 'linux';
    }
    const url = key ? btn.dataset[`${key}Url`] : undefined;
    if (key && url) {
      const size = btn.dataset[`${key}Size`];
      const names = { linux: 'Linux', win: 'Windows', mac: 'macOS (Apple Silicon)' };
      btn.href = url;
      btn.textContent = `Download for ${names[key]}${size ? ` · ${size}` : ''}`;
      btn.setAttribute('rel', 'noopener');
      if (alt) {
        const altUrl = btn.dataset[`${key}AltUrl`];
        const altLabel = key === 'linux' ? '.deb instead' : key === 'mac' ? 'Intel Mac' : '';
        alt.innerHTML = '';
        if (altUrl && altLabel) {
          const a = document.createElement('a');
          a.href = altUrl;
          a.textContent = altLabel;
          alt.append(' · ', a);
        }
        const all = document.createElement('a');
        all.href = '#downloads';
        all.textContent = 'all downloads';
        alt.append(' · ', all);
      }
    }
  }

  const demo = document.querySelector('.ask-demo');
  if (demo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    demo.setAttribute('data-armed', '');
    new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          demo.classList.add('play');
          obs.disconnect();
        }
      }
    }, { threshold: 0.5 }).observe(demo);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 30%, rgba(91, 229, 160, 0.07) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 70% 20%, rgba(139, 123, 255, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse 30% 30% at 30% 60%, rgba(91, 229, 160, 0.04) 0%, transparent 50%);
    pointer-events: none;
    animation: pulse-glow 8s ease-in-out infinite;
  }

  .hero-content {
    position: relative;
    text-align: center;
    padding-top: 4rem;
    padding-bottom: 0;
  }

  h1 {
    margin-bottom: 1.5rem;
    text-shadow: 0 0 40px rgba(91, 229, 160, 0.1);
    animation: glitch 12s infinite;
  }

  .accent {
    color: var(--eldritch);
    text-shadow: 0 0 30px var(--eldritch-glow-strong);
  }

  .hero-hook {
    max-width: 640px;
    margin: 0 auto 1rem;
    color: var(--text-primary);
    font-size: 1.3rem;
    line-height: 1.6;
  }

  .hero-hook em {
    color: var(--eldritch);
  }

  .hero-sub {
    max-width: 620px;
    margin: 0 auto 2rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 0.9rem;
  }

  .hero-dl {
    min-width: 160px;
    justify-content: center;
  }

  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.5rem;
  }

  .hero-version {
    color: var(--eldritch-dim);
    font-weight: 600;
  }

  .hero-meta a {
    color: var(--eldritch-dim);
  }

  .hero-meta a:hover {
    color: var(--eldritch);
    text-decoration: underline;
  }

  .hero-needs {
    max-width: 560px;
    margin: 0 auto 2.5rem;
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .hero-shot {
    max-width: 960px;
    margin: 0 auto 2.5rem;
  }

  .hero-shot-frame {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 1px solid var(--border-accent);
    border-radius: 12px;
    overflow: hidden;
    cursor: zoom-in;
    box-shadow: 0 0 48px rgba(91, 229, 160, 0.12), 0 24px 64px rgba(0, 0, 0, 0.5);
    transition: box-shadow 0.3s, border-color 0.3s;
  }

  .hero-shot-frame:hover {
    border-color: var(--eldritch);
    box-shadow: 0 0 64px rgba(91, 229, 160, 0.2), 0 24px 64px rgba(0, 0, 0, 0.5);
  }

  .hero-shot-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-shot-caption {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    font-style: italic;
    margin-top: 0.75rem;
  }

  .hero-glyphs {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin-bottom: 1rem;
    padding: 0.5rem 0;
    flex-wrap: wrap;
  }

  .hero-glyph {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .glyph-icon {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--eldritch);
    background: var(--eldritch-glow);
    border: 1px solid var(--border-accent);
    padding: 0.25rem 0.45rem;
    border-radius: 5px;
    animation: breathe 4s ease-in-out infinite;
  }

  .hero-glyph:nth-child(2) .glyph-icon {
    color: var(--void-purple);
    background: var(--void-purple-glow);
    border-color: rgba(139, 123, 255, 0.2);
    animation-delay: 1.3s;
  }

  .hero-glyph:nth-child(3) .glyph-icon {
    animation-delay: 2.6s;
  }

  .glyph-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    letter-spacing: 0.01em;
  }

  @keyframes breathe {
    0%, 100% { box-shadow: 0 0 6px rgba(91, 229, 160, 0.1); }
    50% { box-shadow: 0 0 14px rgba(91, 229, 160, 0.25); }
  }

  .hero-desc-heading {
    margin-top: var(--section-gap);
    margin-bottom: 0;
  }

  /* ── The ask demo: the section performs the protocol it describes ── */
  .ask-demo {
    max-width: 620px;
    margin: 2rem auto 2.5rem;
    text-align: left;
  }

  .ask-call {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    margin-bottom: 0.9rem;
  }

  .ask-you {
    color: var(--void-purple);
  }

  .ask-op {
    color: var(--text-dim);
  }

  .ask-code {
    display: inline-block;
    color: var(--eldritch);
    background: none;
    border: none;
    padding: 0;
    font-size: 1em;
  }

  .ask-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    background: var(--eldritch);
    box-shadow: 0 0 8px var(--eldritch-glow-strong);
    animation: cursor-blink 1.1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% { opacity: 0; }
  }

  .ask-reply {
    background: var(--bg-card);
    border: 1px solid var(--border-accent);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 0 24px var(--eldritch-glow);
  }

  .ask-reply-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.9rem;
    background: rgba(18, 18, 30, 0.75);
    border-bottom: 1px solid var(--border);
  }

  .ask-reply-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
    letter-spacing: 0.06em;
  }

  .ask-reply-icon {
    font-size: 0.85em;
    margin-right: 0.15rem;
  }

  .ask-reply-controls {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    user-select: none;
  }

  .ask-reply-body {
    padding: 1.35rem 1.6rem;
  }

  .ask-reply-body p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 0.9rem;
  }

  .ask-reply-body p:last-child {
    margin-bottom: 0;
  }

  /* Orchestrated reveal: armed by JS only when motion is welcome.
     Without JS (or with reduced motion) everything is simply visible. */
  .ask-demo[data-armed] .ask-code {
    width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .ask-demo[data-armed].play .ask-code {
    animation: ask-type 1.3s steps(34, end) 0.3s forwards;
  }

  .ask-demo[data-armed] .ask-reply {
    opacity: 0;
    transform: translateY(10px);
  }

  .ask-demo[data-armed].play .ask-reply {
    animation: reply-in 0.55s ease 1.85s forwards;
  }

  @keyframes ask-type {
    from { width: 0; }
    to { width: 34ch; }
  }

  @keyframes reply-in {
    to { opacity: 1; transform: none; }
  }

  .thesis-link {
    display: inline-block;
    margin-top: 0.25rem;
    color: var(--eldritch-dim);
    font-size: 0.9rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(43, 204, 110, 0.3);
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .thesis-link:hover {
    color: var(--eldritch);
    border-bottom-color: var(--eldritch);
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-secondary);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 0;
    font-style: italic;
    line-height: 1.7;
  }

  .hero-tagline .dim {
    opacity: 0.6;
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
      align-items: center;
    }
    .hero-glyphs {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .ask-call {
      font-size: 0.78rem;
    }
  }
</style>
