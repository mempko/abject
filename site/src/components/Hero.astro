---
/**
 * The front poster: the headline set big with its red band, the eye sigil
 * pierced by a red wedge, the pitch and the download block on the left,
 * the three things that make Abject what it is as a numbered index (each
 * links to its section), the desktop screenshot, and the dictionary joke.
 */
import { latestRelease, platformAssets, fmtSize } from '../lib/releases';
import Shot from './ui/Shot.astro';

const rel = await latestRelease();
const pa = platformAssets(rel);

// Per-platform direct links for the OS-aware button. Everything renders
// without JavaScript; the script only upgrades the primary button.
const direct = {
  linux: pa.linuxAppImage,
  linuxAlt: pa.linuxDeb,
  win: pa.winExe,
  mac: pa.macArmDmg,
  macAlt: pa.macX64Dmg,
};

const things = [
  { n: '01', href: '#make', text: "Say it, and it's running" },
  { n: '02', href: '#team', text: 'A team that asks, plans and replans' },
  { n: '03', href: '#learns', text: 'It gets smarter every time', key: true },
];
---

<section class="hero">
  <div class="container">
    <div class="hero-poster">
      <h1 class="hero-title">
        <span class="t-line t-an">An</span>
        <span class="t-line t-red"><span class="t-red-ink">Abject-Oriented</span></span>
        <span class="t-line t-os">OS</span>
      </h1>

      <svg class="hero-mark" viewBox="0 0 320 320" aria-hidden="true" focusable="false">
        <circle class="mark-well" cx="186" cy="138" r="104" />
        <line class="mark-rule" x1="18" y1="286" x2="306" y2="22" />
        <line class="mark-rule" x1="40" y1="60" x2="300" y2="236" />
        <circle class="mark-ring" cx="186" cy="138" r="104" />
        <ellipse class="mark-pupil" cx="186" cy="138" rx="15" ry="58" />
        <polygon class="mark-wedge" points="0,318 0,272 84,302" />
        <rect class="mark-square" x="274" y="252" width="22" height="22" />
      </svg>

      <div class="hero-copy">
        <p class="hero-hook">
          Describe what you want and an <em>abject</em> appears, window and all.
          It keeps working after you stop talking to it, and it learns from
          every goal.
        </p>
        <p class="hero-sub">
          Software that&rsquo;s connected and personal to you, and you don&rsquo;t
          need to know how to program. It&rsquo;s free, open source, and it runs
          on your machine.
        </p>
        <div class="hero-actions">
          <a
            href="#downloads"
            class="btn btn-primary hero-dl"
            id="hero-dl"
            data-linux-url={direct.linux?.url}
            data-linux-size={fmtSize(direct.linux?.size)}
            data-linux-alt-url={direct.linuxAlt?.url}
            data-win-url={direct.win?.url}
            data-win-size={fmtSize(direct.win?.size)}
            data-mac-url={direct.mac?.url}
            data-mac-size={fmtSize(direct.mac?.size)}
            data-mac-alt-url={direct.macAlt?.url}
          >Download</a>
          <a href="/install#summon" class="btn btn-outline">Build from Source</a>
        </div>
        <p class="hero-meta">
          {rel.version && <span class="hero-version">v{rel.version}</span>}
          <span>Linux &middot; Windows &middot; macOS</span>
          <span class="hero-meta-sep">&middot;</span>
          <span>free and open source, GPL-3.0</span>
          <span class="hero-meta-sep">&middot;</span>
          <a href="/install">install guide</a>
          <span id="hero-dl-alt" class="hero-dl-alt"></span>
        </p>
        <p class="hero-needs">
          It needs a model to think with: an API key, a free local model through
          Ollama, or a coding CLI you already log into. You pick one the first
          time you open it.
        </p>
      </div>

      <nav class="hero-claims" aria-label="One idea, and three things it makes possible">
        <p class="claims-label">One idea</p>
        <a class="idea" href="#big-idea">
          <span class="idea-n">00</span>
          <span class="idea-text">Everything is an abject, and every abject can be asked</span>
          <span class="claim-go" aria-hidden="true">&#9654;</span>
        </a>
        <p class="claims-label">Three things it makes possible</p>
        <ol>
          {things.map((c) => (
            <li class:list={['claim', { key: c.key }]}>
              <a href={c.href}>
                <span class="claim-n">{c.n}</span>
                <span class="claim-text">{c.text}</span>
                <span class="claim-go" aria-hidden="true">&#9654;</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <div class="hero-shot">
      <Shot id="hero" focus eager caption="A real desktop: a graph of 474 notes and 14,615 links, the list of chats, and a chat working on a goal to upgrade a fish tank." />
    </div>

    <p class="hero-tagline">
      <span class="tag-word">abject</span>
      We call them abjects. As in AI Object. As in abject horror.
      <span class="tag-joke">The name fits.</span>
    </p>
    </div>
  </div>
</section>

<script>
  // OS-aware primary button. Phones and unknown platforms keep the anchor
  // to the download section, which lists everything.
  const btn = document.getElementById('hero-dl') as HTMLAnchorElement | null;
  const alt = document.getElementById('hero-dl-alt');
  if (btn) {
    const ua = navigator.userAgent;
    const plat = navigator.platform || '';
    const mobile = /Android|iPhone|iPad|iPod/i.test(ua) || (plat === 'MacIntel' && navigator.maxTouchPoints > 1);
    let key: 'linux' | 'win' | 'mac' | null = null;
    if (!mobile) {
      if (/Win/.test(plat)) key = 'win';
      else if (/Mac/.test(plat)) key = 'mac';
      else if (/Linux|X11/.test(plat)) key = 'linux';
    }
    const url = key ? btn.dataset[`${key}Url`] : undefined;
    if (key && url) {
      const size = btn.dataset[`${key}Size`];
      const names = { linux: 'Linux', win: 'Windows', mac: 'macOS (Apple Silicon)' };
      btn.href = url;
      btn.textContent = `Download for ${names[key]}${size ? ` · ${size}` : ''}`;
      btn.setAttribute('rel', 'noopener');
      if (alt) {
        const altUrl = btn.dataset[`${key}AltUrl`];
        const altLabel = key === 'linux' ? '.deb instead' : key === 'mac' ? 'Intel Mac' : '';
        alt.innerHTML = '';
        if (altUrl && altLabel) {
          const a = document.createElement('a');
          a.href = altUrl;
          a.textContent = altLabel;
          alt.append(' · ', a);
        }
        const all = document.createElement('a');
        all.href = '#downloads';
        all.textContent = 'all downloads';
        alt.append(' · ', all);
      }
    }
  }

</script>

<style>
  .hero {
    position: relative;
    padding-top: calc(66px + 3rem);
    padding-bottom: calc(var(--section-gap) * 0.5);
    overflow: hidden;
  }

  /* ── The poster: headline, eye mark, copy ── */
  .hero-poster {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    grid-template-areas:
      'title title'
      'copy  claims';
    column-gap: 4rem;
    align-items: start;
  }

  .hero-title {
    grid-area: title;
    position: relative;
    z-index: 1;
    font-size: clamp(2.9rem, 7.9vw, 7.2rem);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: 0.005em;
    margin-bottom: 2.4rem;
  }

  .t-line { display: block; }

  .t-an { color: var(--bone-heading); }

  /* The red band: a block that bleeds off the left edge of the page and
     ends in a wedge, with the word set in the on-red ink. */
  .t-red {
    position: relative;
    width: max-content;
    max-width: 100%;
    margin: 0.06em 0 0.1em;
    padding: 0.06em 0.34em 0.02em 0;
    background: var(--red);
    color: var(--on-red);
    clip-path: polygon(-100vw 0, 100% 0, calc(100% - 0.22em) 100%, -100vw 100%);
  }

  .t-red::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    width: 100vw;
    background: var(--red);
  }

  .t-red-ink { position: relative; }

  .t-os { color: var(--bone-heading); }

  /* The eye sits at the top right, where the backdrop's eclipse hangs, so
     the watermark seems to come into focus behind the headline. */
  .hero-mark {
    position: absolute;
    top: 0.5rem;
    right: -0.5rem;
    width: clamp(150px, 22vw, 310px);
    height: auto;
    overflow: visible;
  }

  .mark-well { fill: var(--void); }

  .mark-rule {
    stroke: var(--bone);
    stroke-opacity: 0.22;
    stroke-width: 1.5;
  }

  .mark-ring {
    fill: none;
    stroke: var(--red);
    stroke-width: 20;
  }

  .mark-pupil {
    fill: var(--living);
    filter: drop-shadow(0 0 10px var(--living-glow));
    transform-box: fill-box;
    transform-origin: center;
    animation: eye-blink 9s ease-in-out infinite;
  }

  .mark-wedge { fill: var(--red); }
  .mark-square { fill: var(--brass); }

  @keyframes eye-blink {
    0%, 93%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.08); }
  }

  .hero-copy { grid-area: copy; max-width: 640px; }

  .hero-hook {
    color: var(--bone);
    font-size: 1.4rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .hero-hook em {
    color: var(--bone-heading);
    font-style: italic;
    border-bottom: 3px solid var(--red);
  }

  .hero-sub {
    color: var(--bone-2);
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 2.1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .hero-dl {
    min-width: 200px;
    padding: 1.05rem 2rem;
    font-size: 1.12rem;
  }

  .hero-actions .btn-outline { padding: 1.05rem 1.8rem; font-size: 1.05rem; }

  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--bone-meta);
    margin-bottom: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
  }

  .hero-version { color: var(--brass); font-weight: 600; }

  .hero-meta a,
  .hero-meta :global(a) {
    color: var(--living);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(91, 229, 160, 0.45);
  }

  .hero-meta a:hover,
  .hero-meta :global(a:hover) { color: var(--bone-heading); text-decoration-color: var(--red); }

  .hero-needs {
    max-width: 560px;
    padding-left: 0.9rem;
    border-left: 3px solid var(--red);
    font-size: 0.92rem;
    color: var(--bone-3);
    line-height: 1.6;
  }

  /* ── The three things: a numbered index beside the copy; each row links
     to its section, and the third (the one that learns) wears the red. ── */
  .hero-claims { grid-area: claims; margin-top: 0.4rem; }

  .claims-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-meta);
    margin-bottom: 0.6rem;
  }

  /* The one idea leads, on a paper slab; the three follow from it. */
  .idea {
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
    padding: 1rem 0.8rem 1.05rem 0.7rem;
    background: #efe6d1;
    box-shadow: var(--print);
    text-decoration: none;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .idea:hover { transform: translate(-1px, -1px); box-shadow: 7px 7px 0 var(--shadow-ink); }

  .idea-n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.1rem;
    line-height: 1;
    color: var(--red);
  }

  .idea-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #16130f;
  }

  .idea .claim-go { color: var(--red); }

  .hero-claims ol {
    list-style: none;
    border-top: 4px solid var(--red);
    border-bottom: var(--rule-w) solid var(--rule-mid);
    background: rgba(6, 7, 10, 0.72);
  }

  .claim + .claim { border-top: var(--rule-w) solid var(--rule-mid); }

  .claim a {
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    padding: 1.05rem 0.4rem 1.1rem 0;
    text-decoration: none;
    transition: background-color 0.15s, padding 0.15s;
  }

  .claim a:hover { background: rgba(211, 47, 34, 0.1); padding-left: 0.4rem; }

  .claim-n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.1rem;
    line-height: 1;
    color: var(--red);
  }

  .claim-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--bone-heading);
  }

  .claim-go { font-size: 0.75rem; color: var(--bone-faint); }
  .claim a:hover .claim-go { color: var(--red); }

  .claim.key a { background: var(--red); padding-left: 0.6rem; }
  .claim.key .claim-n, .claim.key .claim-text, .claim.key .claim-go { color: var(--on-red); }
  .claim.key a:hover { background: var(--red-hot); }

  /* ── The desktop screenshot ── */
  .hero-shot { margin-top: 4.5rem; }

  /* ── The dictionary joke, as a footnote under the screenshot ── */
  .hero-tagline {
    margin-top: 1.6rem;
    max-width: 900px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--bone-3);
  }

  .tag-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bone-heading);
  }

  .hero-tagline .dim { color: var(--bone-meta); }

  .tag-n { color: var(--red); font-weight: 600; margin: 0 0.2rem 0 0.4rem; }

  .tag-joke { font-style: italic; color: var(--bone-meta); margin-left: 0.4rem; }

  /* ── Narrow screens ── */
  @media (max-width: 980px) {
    .hero-poster {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'title'
        'copy'
        'claims';
    }
    .hero-claims { margin-top: 2.5rem; max-width: 640px; }
  }

  @media (max-width: 640px) {
    .hero { padding-top: calc(66px + 2.5rem); }
    .hero-title { font-size: clamp(2.3rem, 11.4vw, 4rem); margin-bottom: 3.6rem; }
    /* On a phone the eye drops beside the short OS line, under the band. */
    .hero-mark { top: calc(clamp(2.3rem, 11.4vw, 4rem) * 2); right: 0; width: 26vw; }
    .hero-hook { font-size: 1.2rem; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-dl { min-width: 0; }
    .hero-shot { margin-top: 3rem; }
    .claim a { padding: 1rem 0.2rem 1.1rem 0; }
    .claim.key a { padding-left: 0.5rem; }
    .tag-joke { display: block; margin: 0.3rem 0 0; }
  }
</style>
