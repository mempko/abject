---
import SectionHead from './ui/SectionHead.astro';

interface Props {
  /** Section number shown in the header (the page decides). */
  num?: string;
}

const { num = '06' } = Astro.props;

const features = [
  {
    icon: '{>}',
    abjects: 'ObjectCreator · Chat',
    title: 'Describe what you want.',
    hook: '"A todo list that syncs my calendar." Type that and a window appears.',
    desc: 'The system asks the objects that already exist what they can do, then writes a new object and gives it a window, a mailbox and its own ask handler. It is not a chat answer that scrolls away. It is a real running object with source code you can open and read, and it already knows how to talk to its neighbors.',
  },
  {
    icon: '{@}',
    abjects: 'IdentityObject · PeerRegistry',
    title: 'Your machine makes its own identity.',
    hook: 'There is no signup and no cloud asking for your email.',
    desc: 'On first run your machine generates a cryptographic key, and that key is its address. Nobody issued it, so nobody can revoke it. When you share with a friend, every message is encrypted end to end. The server that introduces you never sees the conversation.',
  },
  {
    icon: '{=}',
    abjects: 'ScrumMaster · GoalManager · TupleSpace',
    title: 'Give it a goal. A team works it in sprints.',
    hook: 'The plan is rewritten every round instead of frozen at the start.',
    desc: 'When you create a goal, the ScrumMaster asks each agent what it can do and assigns the round\'s tasks. When the round ends it reviews what actually happened, failures included, and plans the next round. It keeps going for as many rounds as the work needs. Goals sync across your peers, so a goal survives the machine it started on.',
  },
  {
    icon: '{!}',
    abjects: 'Negotiator · ProxyGenerator · HealthMonitor',
    title: 'Broken connections heal themselves.',
    hook: 'When a connection fails more than 10% of the time, the LLM writes a replacement from the errors.',
    desc: 'Objects that were not built for each other talk through a proxy. When a proxy starts failing, Abject collects the recent errors and asks the LLM to write a better proxy with those failures in front of it. Then it swaps the new one in. When that works you never notice. When it doesn\'t, you find out in the logs.',
  },
  {
    icon: '{~}',
    abjects: 'SkillRegistry',
    title: 'Skills are just markdown files.',
    hook: 'Claude Code and OpenClaw skills both work, at the same time.',
    desc: 'Drop a SKILL.md into the skills folder and rescan. The next agent that needs that ability reads it. There is no build step and no registry to sign up for. MCP servers you already set up for other tools are imported the same way, and a catalog browser finds more.',
  },
  {
    icon: '{*}',
    abjects: 'KnowledgeBase',
    title: 'It remembers what it learns.',
    hook: 'Learning happens when things go wrong. The lessons go into a knowledge base.',
    desc: 'Facts, snippets and lessons from goals that went sideways all go into a knowledge base with full-text search. Agents pull the relevant ones into their next task. Each workspace has its own knowledge. Keep a workspace private and its knowledge never leaves your machine. Share it and the knowledge syncs to every peer in it.',
  },
];

// Mosaic tiles: one wide red tile, one wide paper tile, the rest outlined.
const tiles = ['w2 solid-red', 'outline', 'outline', 'outline', 'w2 paper', 'outline'];

const capabilities = [
  { icon: '{W}', name: 'Web Browsing', desc: 'Headless Playwright automation' },
  { icon: '{S}', name: 'Web Search', desc: 'Search and fetch with parsing' },
  { icon: '{$}', name: 'Shell Execution', desc: 'Run commands on the host' },
  { icon: '{/}', name: 'Host Filesystem', desc: 'Read and write real files' },
  { icon: '{#}', name: 'Screenshots', desc: 'Capture canvas, widgets, pages' },
  { icon: '{C}', name: 'Scheduled Tasks', desc: 'Cron-style jobs per workspace' },
  { icon: '{K}', name: 'Knowledge Base', desc: 'Full-text memory, synced to peers' },
  { icon: '{.}', name: 'Portable Skills', desc: 'Claude Code & OpenClaw formats' },
  { icon: '{P}', name: 'File Transfer', desc: 'Peer-to-peer, encrypted' },
  { icon: '{M}', name: 'Media & Speech', desc: 'Audio, video, text to speech and back' },
  { icon: '{&}', name: 'Shared State', desc: 'Synced across peers (LWW-CRDT)' },
  { icon: '{!}', name: 'Permission Gates', desc: 'Prompts, allow lists, standing rules' },
  { icon: '{⚙}', name: 'Other Languages', desc: 'C++ abjects as sandboxed WASM' },
];
---

<section id="features" class="features-section">
  <div class="container">
    <SectionHead num={num} kicker="Capabilities" title="Everything Is an Abject">
      <p>
        Everything in the system is an abject, and I do mean everything. Each one below is a
        running object. You can message it, stop it, restart it, fork it, or ask it what it just did.
      </p>
    </SectionHead>

    <div class="mosaic bestiary">
      {features.map((f, i) => (
        <article class:list={['tile', tiles[i]]}>
          <p class="tile-tags">
            {f.abjects.split(' · ').map((a) => <span class="tile-tag">{a}</span>)}
          </p>
          <h3>{f.title}</h3>
          <p class="hook">{f.hook}</p>
          <p class="desc">{f.desc}</p>
          <span class="tile-glyph" aria-hidden="true">{f.icon}</span>
        </article>
      ))}
    </div>

    <div id="capabilities" class="cap-block">
      <div class="cap-head">
        <p class="cap-kicker"><span class="cap-square" aria-hidden="true">&#9632;</span> Built in</p>
        <h3 class="cap-heading">What Abjects Can Use</h3>
        <p class="cap-intro">
          Every capability is an abject too, so any abject can ask it what it does. To give the
          system a new ability you add a new abject, not a plugin.
        </p>
      </div>
      <ul class="ledger cap-ledger">
        {capabilities.map((c) => (
          <li>
            <span class="ix">{c.icon}</span>
            <span class="t">{c.name}</span>
            <span class="n">{c.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* ── The bestiary: a mosaic of six tiles ── */
  .bestiary {
    grid-auto-flow: dense;
    gap: 1.25rem;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.5rem 1rem;
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .tile:hover { transform: translate(-2px, -2px); box-shadow: var(--print); }
  .tile.solid-red:hover { box-shadow: 6px 6px 0 var(--red-deep); }

  .tile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.1rem;
    position: relative;
    z-index: 1;
  }

  .tile-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule-mid);
    color: var(--bone-3);
  }

  .tile h3 {
    position: relative;
    z-index: 1;
    font-size: 1.35rem;
    line-height: 1.1;
    margin-bottom: 0.85rem;
  }

  .tile.w2 h3 { font-size: clamp(1.7rem, 2.8vw, 2.4rem); line-height: 1.02; max-width: 16ch; }

  .tile .hook {
    position: relative;
    z-index: 1;
    font-style: italic;
    color: var(--bone);
    font-size: 0.97rem;
    line-height: 1.5;
    margin-bottom: 0.8rem;
  }

  .tile .desc {
    position: relative;
    z-index: 1;
    color: var(--bone-3);
    font-size: 0.93rem;
    line-height: 1.62;
  }

  .tile.w2 .hook { font-size: 1.1rem; max-width: 46ch; }
  .tile.w2 .desc { max-width: 58ch; }

  /* A big mono glyph printed into the corner of each tile. */
  .tile-glyph {
    margin-top: auto;
    padding-top: 0.9rem;
    align-self: flex-end;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--bone-faint);
    opacity: 0.55;
    pointer-events: none;
  }

  .tile.outline h3 { color: var(--bone-heading); }

  /* The red tile. */
  .tile.solid-red .tile-tag { border-color: rgba(246, 239, 219, 0.6); color: var(--on-red); }
  .tile.solid-red .hook { color: var(--on-red); }
  .tile.solid-red .desc { color: rgba(246, 239, 219, 0.88); }
  .tile.solid-red h3 { font-size: clamp(2.2rem, 4.4vw, 3.8rem); line-height: 0.95; margin-bottom: 1.2rem; }
  .tile.solid-red .tile-glyph { color: var(--on-red); opacity: 0.35; font-size: 6.5rem; }

  /* The paper tile: ink on the agitprop ground. */
  .tile.paper .tile-tag { border-color: rgba(22, 19, 15, 0.35); color: #3f392f; }
  .tile.paper .hook { color: #16130f; border-left: 3px solid var(--red); padding-left: 0.7rem; }
  .tile.paper .desc { color: #3f392f; }
  .tile.paper .tile-glyph { color: var(--red); opacity: 0.8; font-size: 5rem; }

  /* ── What the abjects can touch: a two-column ledger ── */
  .cap-block {
    margin-top: 5.5rem;
    scroll-margin-top: 90px;
  }

  .cap-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: 1.75rem;
  }

  .cap-kicker {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone-meta);
  }

  .cap-square { color: var(--red); margin-right: 0.35rem; }

  .cap-heading {
    font-size: clamp(1.5rem, 2.8vw, 2.2rem);
    line-height: 1.05;
  }

  .cap-intro {
    color: var(--bone-2);
    font-size: 1rem;
    line-height: 1.65;
  }

  .cap-ledger {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    column-gap: 3rem;
  }

  .cap-ledger > li {
    grid-template-columns: 3.5rem minmax(0, 0.9fr) minmax(0, 1.2fr);
    padding: 0.8rem 0;
  }

  .cap-ledger .ix { color: var(--brass); font-weight: 700; }
  .cap-ledger .t { font-size: 1rem; }
  .cap-ledger .n { font-family: var(--font-mono); font-size: 0.76rem; color: var(--bone-meta); }

  @media (max-width: 900px) {
    .cap-head { grid-template-columns: 1fr; }
    .cap-ledger { grid-template-columns: 1fr; grid-template-rows: none; grid-auto-flow: row; }
  }

  @media (max-width: 640px) {
    .tile { padding: 1.3rem 1.2rem 0.9rem; }
    .tile-glyph, .tile.solid-red .tile-glyph, .tile.paper .tile-glyph { font-size: 2.4rem; }
    .cap-ledger > li { grid-template-columns: 3rem minmax(0, 1fr); row-gap: 0.15rem; }
  }
</style>
