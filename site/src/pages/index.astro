---
/**
 * The landing page: the hero, 00 the big idea (every object can be asked),
 * then the three things built on it (01 make, 02 the team, 03 learning),
 * then 04 yours and 05 get it.
 * Everything else lives on /why and /install; the script at the bottom
 * sends old landing anchors to their new homes.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BigIdea from '../components/BigIdea.astro';
import SayIt from '../components/SayIt.astro';
import Team from '../components/Team.astro';
import Learns from '../components/Learns.astro';
import Yours from '../components/Yours.astro';
import GetAbject from '../components/GetAbject.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Abject: An Abject-Oriented OS"
  description="An Abject-Oriented OS for people to create software that's connected and personal to them. Every object answers ask in plain English. Free and open source."
>
  <Header />
  <main>
    <Hero />
    <BigIdea />
    <SayIt />
    <Team />
    <Learns />
    <Yours />
    <GetAbject />
  </main>
  <Footer />
  <script is:inline>
    // Old landing anchors, now elsewhere: keep shared links working. Only
    // hashes that no longer exist on this page are redirected.
    (function () {
      var moved = {
        capabilities: '/why#capabilities',
        features: '/why#features',
        architecture: '/why#architecture',
        spreading: '/why#spreading',
        lineage: '/why#lineage',
        why: '/why#why',
        summon: '/install#summon',
        providers: '/install#mind',
        faq: '/install#faq',
        'first-abject': '/install#first-abject',
        'whats-new': '/changelog',
        sightings: '#make',
        scene: '#make',
        examples: '#make'
      };
      function follow() {
        var id = decodeURIComponent(location.hash.slice(1));
        if (!id || document.getElementById(id) || !moved[id]) return;
        location.replace(moved[id]);
      }
      follow();
      window.addEventListener('hashchange', follow);
    })();
  </script>
</Layout>
