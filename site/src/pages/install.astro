---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Faq from '../components/Faq.astro';
import Providers from '../components/Providers.astro';
import QuickStart from '../components/QuickStart.astro';
import { latestRelease, platformAssets, fmtSize } from '../lib/releases';

const rel = await latestRelease();
const pa = platformAssets(rel);
const v = rel.version || 'x.y.z';
---

<Layout
  title="Install - Abject"
  description="How to install Abject on Linux, Windows, and macOS. The questions people ask first, the warnings an unsigned app triggers, picking a model from fourteen providers, pairing your phone, where your data lives, building from source, and what to do when something goes wrong."
>
  <Header />
  <main class="install">
    <div class="container">

      <header class="hero">
        <div class="hero-text band">
          <p class="kicker"><span class="sigil" aria-hidden="true"></span><span>Install</span></p>
          <h1 class="hero-title">From Download to Running</h1>
          <span class="hero-bar" aria-hidden="true"></span>
          <p class="lede">
            This page takes you from the download button to a desktop full of abjects you can
            talk to. Most of it covers the two warnings an unsigned app triggers and the one
            settings tab you fill in once.
          </p>
          <p class="hero-actions">
            <a href="/#downloads" class="btn btn-primary">Get the download</a>
            {rel.version && <span class="hero-version">current: <span class="ver">v{rel.version}</span></span>}
          </p>
        </div>

        <!-- Contents: a plain ruled index; the one step you cannot skip wears red. -->
        <nav class="toc" aria-label="On this page">
          <p class="toc-label">Contents</p>
          <ol class="toc-list">
            <li><a href="#requirements">What you need</a></li>
            <li><a href="#faq">Questions</a></li>
            <li><a href="#first-launch">First launch, per platform</a></li>
            <li class="key"><a href="#mind">Pick a model</a></li>
            <li><a href="#first-abject">Your first abject</a></li>
            <li><a href="#phone">Your phone</a></li>
            <li><a href="#command-line">The command line</a></li>
            <li><a href="#data">Where things live</a></li>
            <li><a href="#network">What it talks to</a></li>
            <li><a href="#updating">Updating and uninstalling</a></li>
            <li><a href="#summon">Build from source</a></li>
            <li><a href="#trouble">When something goes wrong</a></li>
          </ol>
        </nav>
      </header>

      <!-- 01: a mosaic of the four requirements -->
      <section id="requirements" class="sec">
        <SectionHead num="01" title="What you need" />
        <ul class="mosaic needs">
          <li class="need-desk outline"><strong>A desktop.</strong> A 64-bit Linux from the last few years, Windows 10 or later, or macOS 11 or later. Phones join later as remote views; the objects themselves live on the desktop.</li>
          <li class="need-disk paper"><strong>Disk.</strong> The installers are large because a headless browser ships inside so abjects can browse the web for you.
            {pa.linuxAppImage && <> Linux {fmtSize(pa.linuxAppImage.size)},</>}
            {pa.winExe && <> Windows {fmtSize(pa.winExe.size)},</>}
            {pa.macArmDmg && <> macOS {fmtSize(pa.macArmDmg.size)}.</>}
          </li>
          <li class="need-mind"><strong>A model to think with.</strong> An API key from any of the supported providers, a free local model through <a href="https://ollama.com" target="_blank" rel="noopener">Ollama</a>, or the Claude Code, Codex, or Antigravity CLI already installed and logged in on this machine. Details in <a href="#mind">Pick a model</a>.</li>
          <li class="need-acct solid-red"><strong>No account.</strong> Abject has no signup. Your machine creates its own identity the first time it runs.</li>
        </ul>
      </section>

    </div>

    <!-- 02: the practical questions, as a ruled accordion on the void -->
    <Faq num="02" ground="void" only={['code', 'key', 'safe', 'terminal', 'cost']} />

    <div class="container">

      <!-- 03: platform columns; the shells are real terminals, so they keep their window -->
      <section id="first-launch" class="sec">
        <SectionHead num="03" title="First launch, per platform" />
        <div class="prose">
          <p>
            The builds aren't code-signed yet, so each operating system warns you once, the same
            way it warns you about any software that hasn't paid for a certificate. You only see
            it the first time. Here is what to click.
          </p>
        </div>

        <div class="platforms">
          <div class="platform">
            <h3 class="sub">Linux</h3>
            <p><strong>AppImage.</strong> Mark it executable and run it:</p>
            <div class="code-win">
              <div class="code-bar" aria-hidden="true">shell</div>
              <pre><code>chmod +x Abject-{v}.AppImage
./Abject-{v}.AppImage</code></pre>
            </div>
            <p>
              AppImages need FUSE 2. On Ubuntu 22.04 and later and on Debian, install it once with
              <code>sudo apt install libfuse2</code> (Fedora: <code>sudo dnf install fuse</code>).
              The AppImage starts Electron without the Chromium sandbox helper, because AppImages
              cannot carry a setuid binary and recent Ubuntu blocks user namespaces by default;
              the abject sandboxes are separate from that and unaffected.
            </p>
            <p><strong>.deb.</strong> Installs a launcher entry and a <code>abjects</code> command:</p>
            <div class="code-win">
              <div class="code-bar" aria-hidden="true">shell</div>
              <pre><code>sudo apt install ./abjects_{v}_amd64.deb</code></pre>
            </div>
          </div>

          <div class="platform">
            <h3 class="sub">Windows</h3>
            <ol class="steps">
              <li>Run the installer. SmartScreen shows "Windows protected your PC".</li>
              <li class="key">Click <strong>More info</strong>, then <strong>Run anyway</strong>.</li>
              <li>Choose an install folder if you want one other than the default. Abject appears in the Start menu.</li>
            </ol>

            <h3 class="sub">macOS</h3>
            <ol class="steps">
              <li>Open the .dmg and drag Abject into Applications.</li>
              <li>Open it once. macOS says it cannot verify the developer and offers only to move it to the Trash. Click <strong>Done</strong>, not Trash.</li>
              <li class="key">Open <strong>System Settings, Privacy &amp; Security</strong>, scroll to the bottom, and click <strong>Open Anyway</strong> next to Abject. Confirm once.</li>
            </ol>
            <p>
              Prefer the terminal? Clearing the quarantine flag does the same thing in one line:
            </p>
            <div class="code-win">
              <div class="code-bar" aria-hidden="true">shell</div>
              <pre><code>xattr -d com.apple.quarantine /Applications/Abject.app</code></pre>
            </div>
            <p>
              Pick the build that matches your Mac: Apple Silicon for anything from 2020 on with an
              M-series chip, Intel otherwise (Apple menu, About This Mac). The download section
              lists whichever builds the current release ships.
            </p>
          </div>
        </div>
      </section>

      <!-- 04: the settings panel is software on screen, so it stays a window -->
      <section id="mind" class="sec">
        <SectionHead num="04" title="Pick a model" />
        <div class="mind-grid">
        <div class="win focus mind-win">
          <div class="win-bar">
            <span class="sigil" aria-hidden="true"></span>
            <span class="title">Settings &middot; AI</span>
            <span class="btns" aria-hidden="true">? &minus; &#9633; &times;</span>
          </div>
          <div class="win-body prose">
            <p>
              On first launch the settings window opens by itself on the <strong>AI</strong> tab.
              Abjects need a model to think with, so this is the one step you can't skip.
              Pick any of these, then click <strong>Save</strong>:
            </p>
            <ul class="minds">
              <li><strong>An API key.</strong> Anthropic, OpenAI, Google Gemini, OpenRouter, DeepSeek, xAI Grok, Moonshot Kimi, MiniMax, or Meta. Paste the key next to the provider. Keys are stored in the app's data directory on your machine and sent only to that provider.</li>
              <li><strong>Ollama, free and local.</strong> Install Ollama, pull a model (<code>ollama pull</code> and a model name), and leave it running. Abject finds it at <code>http://localhost:11434</code> without configuration; a different host goes in the Ollama URL field.</li>
              <li><strong>A coding CLI you already use.</strong> If the <code>claude</code>, <code>codex</code>, or <code>agy</code> command is on your PATH and logged in, it shows up as a provider and uses the subscription you already pay for.</li>
              <li><strong>A peer.</strong> Another Abject on the mesh can serve you its models through the PeerLLM provider. Useful when one machine in the house has the GPU.</li>
            </ul>
            <p>
              Below the keys are four <strong>tiers</strong>: smart, balanced, fast, and code.
              Each one points at a provider and a model. Leave the defaults, or send the simple
              bookkeeping to a cheap model and keep the smart one for planning. Abjects ask for a
              tier, never a specific model, so you can change your mind later.
            </p>
          </div>
        </div>
        <Providers bare />
        </div>
      </section>

      <!-- 05: a stepper along one rule; typing the request is the key step -->
      <section id="first-abject" class="sec">
        <SectionHead num="05" title="Your first abject" />
        <ol class="stepper first-steps">
          <li><span class="step-n" aria-hidden="true">01</span><p>Click <strong>Chat</strong> in the sidebar. A chat window opens.</p></li>
          <li class="key"><span class="step-n" aria-hidden="true">02</span><p>Type what you want, in your words. Try: <em>"a countdown to tonight's sunset for my city, with the sun sliding toward the horizon."</em></p></li>
          <li><span class="step-n" aria-hidden="true">03</span><p>Watch the goal run. A window appears when the object is ready. Close the chat if you like; the window keeps running.</p></li>
          <li><span class="step-n" aria-hidden="true">04</span><p>Click the <strong>?</strong> in any window's title bar to see what that object can do and ask it questions in plain English.</p></li>
        </ol>
        <div class="prose after-steps">
          <p>
            The first time an abject wants to run a shell command, read a file outside its own
            sandbox, or reach a new website, a permission prompt appears and waits. Say yes once,
            or set standing rules under <strong>Settings, Permissions</strong>. The Web sub-tab
            has domain allow and deny lists; Filesystem has allowed paths and a read-only mode;
            Shell has a command allow list.
          </p>
        </div>
      </section>

      <!-- 06: a split, the desktop's half and the phone's half -->
      <section id="phone" class="sec">
        <SectionHead num="06" title="Your phone" />
        <div class="prose">
          <p>
            There is nothing to install on the phone. The desktop app shows itself in the
            phone's browser over a direct, encrypted connection:
          </p>
        </div>
        <div class="split phone-split">
          <div>
            <p class="side-label">Desktop</p>
            <ol class="steps">
              <li>On the desktop, click <strong>Network</strong> in the toolbar and open the <strong>Frontends</strong> tab.</li>
              <li class="key">Click <strong>Generate Pairing QR</strong>. The code is single-use and expires in about five minutes.</li>
            </ol>
          </div>
          <span class="rule" aria-hidden="true"></span>
          <div>
            <p class="side-label hand">Phone</p>
            <ol class="steps from-3" start="3">
              <li>Scan it with the phone's camera. It opens <code>client.abject.world</code> with a pairing token, generates its own key pair, finds your desktop through the signaling server, and connects over WebRTC.</li>
              <li>After the handshake the phone is remembered. Next time it reconnects on its own; revoke it from the same Frontends tab whenever you like.</li>
            </ol>
          </div>
        </div>
        <div class="prose after-split">
          <p>
            The signaling server only introduces the two ends; it never sees the session. When
            the phone is on a cell network that blocks direct connections, traffic relays through
            a TURN server if the signaling server offers one, still encrypted end to end.
          </p>
        </div>
      </section>

      <!-- 07: big type, the command's name carries the section -->
      <section id="command-line" class="sec">
        <SectionHead num="07" title="The command line" />
        <div class="cli">
          <p class="stat" aria-hidden="true">
            <span class="big">abject</span>
            <span class="cap">abject.world/install.sh</span>
          </p>
          <div class="prose">
            <p>
              <strong>abject</strong> is Abject in a terminal: your chats, goals, and permission
              prompts, one tab each. It runs where the desktop app can't, on a server, over SSH,
              on a machine with no screen. Install it with one line,
              <code>curl -fsSL https://abject.world/install.sh | sh</code> on Linux and macOS or
              <code>irm https://abject.world/install.ps1 | iex</code> in PowerShell, then run
              <code>abject</code>.
            </p>
            <p>
              The first run walks you through setup (a model, and what agents may do without
              asking) and starts the backend in the background. Quitting the chat leaves it
              running, so goals keep going. <code>abject stop</code> stops it, and
              <code>abject service install</code> starts it whenever you log in. On a machine
              where the desktop app is open, <code>abject</code> talks to the app instead; both
              use the same data directory, so it is the same workspaces either way.
            </p>
            <p>
              Questions from agents wait for you. Answer them in the chat, or from any shell
              with <code>abject questions</code> and <code>abject answer</code>. On a machine
              nobody watches, <code>abject mode allow</code> or <code>abject mode deny</code>
              answers for you. <code>abject help</code> lists the rest.
            </p>
          </div>
        </div>
      </section>

      <!-- 08: three path columns between heavy rules -->
      <section id="data" class="sec">
        <SectionHead num="08" title="Where things live" />
        <div class="prose">
          <p>Everything Abject knows about you is in one directory:</p>
        </div>
        <dl class="paths">
          <div><dt>Linux</dt><dd><code>~/.config/abject</code></dd></div>
          <div><dt>macOS</dt><dd><code>~/Library/Application Support/abject</code></dd></div>
          <div><dt>Windows</dt><dd><code>%APPDATA%\abject</code></dd></div>
        </dl>
        <div class="prose">
          <p>
            Inside: your identity keys, provider keys, every workspace and the objects in it,
            the knowledge base, and a <code>skills</code> folder. Drop a SKILL.md into
            <code>skills</code> (Claude Code or OpenClaw format, unchanged) and rescan from
            Settings; the agents can use it on their next task. Set <code>ABJECTS_DATA_DIR</code>
            before launching to put all of it somewhere else. Delete the directory to start
            from scratch.
          </p>
        </div>
      </section>

      <!-- 09: a ledger of the connections -->
      <section id="network" class="sec">
        <SectionHead num="09" title="What it talks to" />
        <div class="prose">
          <p>There is no telemetry and nothing phones home. The connections it does make:</p>
        </div>
        <ol class="ledger talks">
          <li><span class="ix" aria-hidden="true">01</span><strong class="t">Your model provider,</strong> <span class="n">whichever you chose. With Ollama that is your own machine.</span></li>
          <li><span class="ix" aria-hidden="true">02</span><strong class="t"><code>signal.abject.world</code>,</strong> <span class="n">so peers and paired phones can find your machine. It relays introductions only; every session is encrypted end to end with keys the server never has. Run your own with <code>pnpm whisper</code> from the source tree and point the app at it.</span></li>
          <li><span class="ix" aria-hidden="true">03</span><strong class="t">The web, when an abject is asked to.</strong> <span class="n">Web search goes through DuckDuckGo with no API key; page fetches and browsing go wherever the task leads, within the domain rules you set under Permissions.</span></li>
        </ol>
      </section>

      <!-- 10: a split, updating on one side, uninstalling on the other -->
      <section id="updating" class="sec">
        <SectionHead num="10" title="Updating and uninstalling" />
        <div class="split update-split">
          <div>
            <p class="side-label">Updating</p>
            <p>
              There is no auto-updater yet. Download the new version and install it over the old
              one; the data directory is untouched and your workspaces come back as they were.
              The <a href="/changelog">changelog</a> says what changed.
            </p>
            <p>
              The command line updates itself: <code>abject update</code> fetches the newest
              release, checks it, and restarts the backend on it.
            </p>
          </div>
          <span class="rule" aria-hidden="true"></span>
          <div>
            <p class="side-label hand">Uninstalling</p>
            <p>
              To uninstall, remove the app the usual way for your platform (delete the AppImage,
              <code>apt remove abjects</code>, the Windows uninstaller, or drag it out of
              Applications) and, if you want no trace, delete the data directory above. For the
              command line, run <code>abject stop</code> and <code>abject service uninstall</code>,
              then delete <code>~/.abject</code> (<code>%LOCALAPPDATA%\abject</code> on Windows).
            </p>
          </div>
        </div>
      </section>

    </div>

    <!-- 11: build from source (the terminal is a shell, so it keeps its window) -->
    <QuickStart num="11" />

    <!-- 12: the troubleshooting sheet, inked on paper -->
    <section id="trouble" class="field-paper cut-top trouble">
      <div class="container">
        <SectionHead num="12" title="When something goes wrong" />
        <dl class="faq">
          <div class="faq-item">
            <dt>The AppImage does nothing when launched.</dt>
            <dd>Almost always missing FUSE 2. Install <code>libfuse2</code> (or <code>fuse</code> on Fedora) and try again. Running it from a terminal shows the actual message.</dd>
          </div>
          <div class="faq-item">
            <dt>"Port 7719 already in use."</dt>
            <dd>Another copy is running, or something else took the port. Set <code>WS_PORT</code> to a free port before launching; the command line's port moves with it (it is always <code>WS_PORT</code> plus four).</dd>
          </div>
          <div class="faq-item">
            <dt>Ollama is running but not offered.</dt>
            <dd>Abject probes <code>http://localhost:11434</code> at startup. If Ollama is on another host or port, enter its URL in the AI tab and save; if it started after Abject, restart Abject.</dd>
          </div>
          <div class="faq-item">
            <dt>The CLI provider is missing.</dt>
            <dd>The <code>claude</code>, <code>codex</code>, or <code>agy</code> command has to be on the PATH of the launched app, not just your shell. Launch Abject from a terminal where the command works, or install the CLI system-wide.</dd>
          </div>
          <div class="faq-item">
            <dt>The window is blank or the desktop looks flat.</dt>
            <dd>The renderer needs WebGL. On machines without it the desktop falls back to a flat 2D mode rather than staying blank; if you see nothing at all, launch from a terminal and read the log.</dd>
          </div>
          <div class="faq-item">
            <dt>I want to start over.</dt>
            <dd>Quit Abject and delete the data directory listed above. The next launch is a fresh first boot, settings window and all.</dd>
          </div>
        </dl>
        <p class="help">
          Still stuck? Ask on <a href="https://discord.gg/B75AeYUYcF" target="_blank" rel="noopener">Discord</a>
          or open an issue on <a href="https://github.com/mempko/abject/issues" target="_blank" rel="noopener">GitHub</a>
          with the log from a terminal launch.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* ── Page frame ── */
  .install {
    padding-top: calc(69px + clamp(3rem, 7vw, 5.5rem));
  }

  /* ── Hero: the poster column plus a ruled contents index ── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }

  .hero-text.band::before { right: 20%; top: 27%; height: 17%; }

  .hero-title {
    font-size: clamp(2.6rem, 6.2vw, 5.2rem);
    line-height: 0.98;
    margin-bottom: 1.4rem;
  }

  .hero-bar {
    display: block;
    width: 180px;
    height: 8px;
    margin-bottom: 1.6rem;
    background: var(--red);
    clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
  }

  .hero .lede {
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.4rem;
    margin-top: 2rem;
  }

  .hero-version {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--bone-meta);
  }

  .hero-version .ver { color: var(--living); }

  .toc { padding-top: 0.6rem; }

  .toc-label {
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-meta);
  }

  .toc-list {
    list-style: none;
    counter-reset: toc;
    padding: 0;
    margin: 0;
    border-top: var(--rule-w) solid var(--rule-strong);
  }

  .toc-list li { counter-increment: toc; border-bottom: 1px solid var(--rule); }

  .toc-list a {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.2rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone-2);
  }

  .toc-list a::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--red);
  }

  .toc-list a::after {
    content: '\25B6' / '';
    font-size: 0.55rem;
    color: var(--bone-faint);
    transition: transform 0.15s, color 0.15s;
  }

  .toc-list a:hover { color: var(--bone-heading); }
  .toc-list a:hover::after { color: var(--red); transform: translateX(3px); }

  .toc-list li.key { border-bottom-color: var(--red); }
  .toc-list li.key a { color: var(--red-hot); font-weight: 600; }
  .toc-list li.key a::after { color: var(--red); }

  /* ── Sections ── */
  .sec {
    position: relative;
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 0;
    scroll-margin-top: 80px;
  }

  section :global(.section-head) { margin-bottom: 2rem; }

  .prose {
    max-width: 780px;
  }

  .prose p,
  .platform p,
  .split p:not(.side-label) {
    color: var(--bone-2);
    font-size: 1.04rem;
    line-height: 1.75;
    margin-bottom: 1.1rem;
  }

  .prose > p:last-child,
  .split p:last-child { margin-bottom: 0; }

  .sub {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
  }

  .sub::before {
    content: '';
    width: 10px;
    height: 10px;
    background: var(--red);
    flex: 0 0 auto;
  }

  .platform .sub:not(:first-child) { margin-top: 2.2rem; }

  /* ── 01: requirements mosaic ── */
  .needs {
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: auto;
    grid-template-areas:
      'desk desk mind'
      'disk acct mind';
    line-height: 1.65;
  }

  .needs li { color: var(--bone-2); }
  .need-desk { grid-area: desk; }
  .need-disk { grid-area: disk; }
  .need-mind { grid-area: mind; border-top: 6px solid var(--red) !important; }
  .need-acct { grid-area: acct; }
  .needs .paper { color: #3f392f; }
  .needs .solid-red { color: rgba(246, 239, 219, 0.88); }

  .needs strong {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.45rem;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--bone-heading);
  }

  .needs .paper strong { color: #16130f; }
