---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Links - Abject"
  description="Quick links to Abject: the website, the source code, and the author. Point your phone at a square."
>
  <Header />
  <main class="links">
    <div class="container">
      <header class="hero">
        <p class="kicker"><span class="sigil" aria-hidden="true"></span><span>Take it with you</span></p>
        <h1 class="hero-title">Point Your Phone at a Square</h1>
        <span class="hero-bar" aria-hidden="true"></span>
        <p class="lede">
          The website, the source, and the human responsible.
        </p>
      </header>

      <ol class="qr-index">
