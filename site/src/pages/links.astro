---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Links - Abject"
  description="Quick links to Abject: the website, the source code, and the author. Point your phone at a square."
>
  <Header />
