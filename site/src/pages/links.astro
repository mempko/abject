  <Footer />
</Layout>

<style>
  .links {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .links-container {
    /* Wider than the prose pages: three presentation-sized QR tiles abreast. */
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem 5rem;
    width: 100%;
  }

  .links-hero {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .links-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .links-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .links-thesis {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .qr-row {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    flex-wrap: wrap;
  }

  .qr-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 1 240px;
    max-width: 420px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem 1.75rem 1.5rem;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .qr-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 30px var(--accent-glow);
  }

  .qr-tile {
    background: #ffffff;
    border-radius: 8px;
    padding: 0.6rem;
    line-height: 0;
    width: 100%;
    max-width: 360px;
  }

  .qr-tile svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .qr-name {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-top: 1.25rem;
  }

  .qr-url {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text-dim);
    margin-top: 0.35rem;
  }

  .links-footnote {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-top: 3rem;
    font-style: italic;
  }
</style>
