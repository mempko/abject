        Your phone's camera app reads these. There's nothing to install. That would be missing the point.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .links {
    min-height: 70vh;
    padding-top: calc(69px + clamp(3rem, 6vw, 5rem));
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  /* ── Hero ── */
  .hero { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }

  .hero-title {
    font-size: clamp(2.6rem, 6.2vw, 5.2rem);
    line-height: 0.98;
    margin-bottom: 1.4rem;
  }

  .hero-bar {
    display: block;
    width: 180px;
    height: 8px;
    margin-bottom: 1.6rem;
    background: var(--red);
    clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
  }

  .hero .lede { font-size: clamp(1.08rem, 1.5vw, 1.25rem); }

  /* ── The index: three ruled columns, numbered ── */
  .qr-index {
    list-style: none;
    counter-reset: qr;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--rule-w) solid var(--rule-strong);
    border-bottom: var(--rule-w) solid var(--rule-strong);
  }

  /* Three presentation-sized QR tiles abreast, each in its own ruled column. */
  .qr-entry { counter-increment: qr; }
  .qr-entry + .qr-entry { border-left: 1px solid var(--rule-mid); }

  .qr-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.2rem, 2.5vw, 2rem) clamp(1rem, 1.8vw, 1.5rem);
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .qr-card:hover { background: var(--panel); }

  .qr-name {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 1.3rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bone-heading);
  }

  .qr-name::before {
    content: counter(qr, decimal-leading-zero);
    font-size: 0.8em;
    color: var(--red);
  }

  /* QR codes need their white quiet zone: keep the tile white and square. */
  .qr-tile {
    width: 100%;
    max-width: 380px;
    padding: 0.6rem;
    line-height: 0;
    background: #ffffff;
    border: var(--rule-w) solid var(--rule-strong);
    box-shadow: var(--print);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .qr-entry.focus .qr-tile { box-shadow: var(--print-red); border-color: var(--red); }

  .qr-card:hover .qr-tile { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--shadow-ink); }
  .qr-entry.focus .qr-card:hover .qr-tile { box-shadow: 8px 8px 0 var(--red); }

  .qr-tile svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .qr-url {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--living);
    word-break: break-word;
  }

  .qr-url::before {
    content: '\25B6' / '';
    font-size: 0.6rem;
    color: var(--red);
    transition: transform 0.15s;
  }

  .qr-card:hover .qr-url::before { transform: translateX(3px); }

  .links-footnote {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--bone-meta);
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .qr-index { grid-template-columns: 1fr; }
    .qr-entry + .qr-entry { border-left: none; border-top: 1px solid var(--rule-mid); }
    .qr-tile { max-width: 320px; }
  }
</style>
