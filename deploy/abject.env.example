# Environment for the Abject headless edition run as a service
# (/etc/abject/abject.env).
# Every variable is optional except where a deployment needs it.

# Where the instance keeps everything: storage, workspaces, packages.json,
# profiles.json. HOME points there too, so tools like npx (MCP servers) have
# somewhere to cache.
ABJECTS_DATA_DIR=/var/lib/abject
HOME=/var/lib/abject

# Ports. The health endpoint (GET /healthz, /version) and the CLI gateway
# (WS_PORT+4) bind loopback. The HTTP gateway (off until enabled; WS_PORT+5)
# binds loopback unless HTTP_BIND says otherwise.
WS_PORT=7719
#CLI_PORT=7723
#HTTP_PORT=7724
#HTTP_BIND=127.0.0.1
# The CLI gateway's interface (loopback unless set; a container sets 0.0.0.0
# and then needs a login).
#CLI_BIND=127.0.0.1

# Login for terminals and the web gateway (both or neither). Also settable
# with `abject setup`.
#ABJECTS_AUTH_USER=
#ABJECTS_AUTH_PASSWORD=

# Workers: pool size (default: cores - 1, at most 8) and per-worker heap
# ceiling in MB (default: sized from the machine's memory).
#ABJECTS_WORKER_COUNT=
#ABJECTS_WORKER_MAX_OLD_SPACE_MB=

# Extra package directories (colon-separated) and the bundled ones.
#ABJECTS_PACKAGE_DIRS=/opt/abject/packages
#ABJECTS_NATIVE_DIR=/opt/abject/lib/native

# Chromium for web browsing (see README.md).
#PLAYWRIGHT_BROWSERS_PATH=/var/lib/abject/browsers

# Peer network: use only these signaling servers, and connect only to
# allowed peers (always including the ones listed).
#ABJECTS_SIGNALING_URLS=wss://signal.example.org
#ABJECTS_PEER_ADMISSION=allowlist
#ABJECTS_ALLOWED_PEERS=
